: 100px;\" class=\"text-end\">FİYAT</div>\n                <div style=\"width: 50px;\"></div> </div>\n\n              <div v-for=\"item in UserStore.cart\" :key=\"item.id\" class=\"cart-item-row p-3 px-4 border-bottom d-flex flex-wrap flex-md-nowrap align-items-center gap-3\">\n                \n                <div class=\"img-wrapper rounded-3 border bg-white flex-shrink-0 position-relative\">\n                   <router-link :to=\"`/product/${item.id}`\"> <img :src=\"item.thumbnail\" :alt=\"item.title\" class=\"img-fluid object-fit-contain w-100 h-100\">\n                   </router-link>\n                </div>\n\n                <div class=\"flex-grow-1\" style=\"min-width: 200px;\">\n                  <h6 class=\"fw-bold mb-1 text-dark\">\n                    <router-link :to=\"`/product/${item.id}`\" class=\"text-decoration-none text-dark\">{{ item.title }}</router-link>\n                  </h6>\n                  <small class=\"text-muted\">Birim Fiyat: {{ item.price }} ₺</small>\n                </div>\n\n                <div class=\"qty-control d-flex align-items-center justify-content-center\">\n                  <div class=\"input-group input-group-sm border rounded-3\" style=\"width: 100px;\">\n                    <button class=\"btn btn-white border-0 px-2\" type=\"button\" @click=\"decreaseQty(item)\">\n                      <i class=\"bi bi-dash\"></i>\n                    </button>\n                    <input type=\"text\" class=\"form-control text-center border-0 bg-white p-0 fw-bold\" :value=\"item.qty\" readonly>\n                    <button class=\"btn btn-white border-0 px-2\" type=\"button\" @click=\"increaseQty(item)\">\n                      <i class=\"bi bi-plus\"></i>\n                    </button>\n                  </div>\n                </div>\n\n                <div class=\"price-col text-end fw-bold fs-5 text-dark\">\n                  {{ (item.price * item.qty).toFixed(2) }} ₺\n                </div>\n\n                <div class=\"remove-col text-end\">\n                  <button class=\"btn btn-link text-muted p-0 hover-danger\" @click=\"removeItem(item)\" title=\"Sepetten Sil\">\n                    <i class=\"bi bi-trash3 fs-5\"></i>\n                  </button>\n                </div>\n\n              </div>\n\n            </div>\n          </div>\n          \n          <div class=\"mt-3\">\n            <router-link to=\"/\" class=\"text-decoration-none text-muted fw-medium small\">\n              <i class=\"bi bi-arrow-left me-1\"></i> Alışverişe Devam Et\n            </router-link>\n          </div>\n        </div>\n\n        <div class=\"col-lg-4\">\n          <div class=\"sticky-summary\">\n            <div class=\"card border-0 shadow-sm rounded-4\">\n              <div class=\"card-header bg-white border-bottom p-4\">\n                <h5 class=\"fw-bold mb-0\">Sipariş Özeti</h5>\n              </div>\n              \n              <div class=\"card-body p-4\">\n                <div class=\"input-group mb-4\">\n                  <input type=\"text\" class=\"form-control bg-light border-0\" placeholder=\"İndirim Kodu\">\n                  <button class=\"btn btn-dark\" type=\"button\">Uygula</button>\n                </div>\n\n                <div class=\"d-flex justify-content-between mb-2 text-muted\">\n                  <span>Ara Toplam</span>\n                  <span>{{ totalPrice }} ₺</span>\n                </div>\n                <div class=\"d-flex justify-content-between mb-2 text-muted\">\n                  <span>Kargo</span>\n                  <span class=\"text-success\">Ücretsiz</span>\n                </div>\n                <div class=\"d-flex justify-content-between mb-3 text-muted\">\n                  <span>KDV (%18)</span>\n                  <span>Dahil</span>\n                </div>\n                \n                <hr class=\"border-dashed my-3\">\n                \n                <div class=\"d-flex justify-content-between align-items-center mb-4\">\n                  <span class=\"fw-bold fs-5\">Genel Toplam</span>\n                  <span class=\"fw-bold fs-3 text-primary\">{{ totalPrice }} ₺</span>\n                </div>\n\n                <router-link to=\"/checkout\" class=\"btn btn-dark w-100 py-3 rounded-pill fw-bold shadow-lg checkout-btn\">\n                  Sepeti Onayla <i class=\"bi bi-arrow-right ms-2\"></i>\n                </router-link>\n                \n                <div class=\"text-center mt-3\">\n                   <div class=\"d-flex justify-content-center gap-2 text-muted fs-4 opacity-50\">\n                      <i class=\"bi bi-credit-card\"></i>\n                      <i class=\"bi bi-paypal\"></i>\n                      <i class=\"bi bi-wallet2\"></i>\n                   </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </div>\n</template>\n\n<script lang=\"ts\">\nimport { defineComponent, computed } from 'vue';\nimport { useUserStore } from '../store/UserStore';\n\nexport default defineComponent({\n  name: 'CartView',\n  setup() {\n    const UserStore = useUserStore();\n\n    const increaseQty = (item: any) => {\n      item.qty += 1;\n    };\n\n    const decreaseQty = (item: any) => {\n      item.qty = Math.max(1, item.qty - 1);\n    };\n\n    const removeItem = (item: any) => {\n      const index = UserStore.cart.indexOf(item);\n      if (index > -1) {\n        UserStore.cart.splice(index, 1);\n      }\n    };\n\n    const totalPrice = computed(() =>\n      UserStore.cart.reduce((acc, item) => acc + item.price * item.qty, 0).toFixed(2)\n    );\n\n    return { UserStore, increaseQty, decreaseQty, removeItem, totalPrice };\n  }\n});\n</script>\n\n<style scoped>\n.page-wrapper {\n  background-color: #f8f9fa;\n  min-height: 100vh;\n  padding-top: 120px; \n}\n\n.img-wrapper {\n  width: 80px;\n  height: 80px;\n  padding: 5px;\n  transition: transform 0.2s;\n}\n.img-wrapper:hover {\n  transform: scale(1.05);\n}\n\n.qty-control .btn:hover {\n  background-color: #f8f9fa;\n  color: #000;\n}\n.qty-control .form-control:focus {\n  box-shadow: none;\n}\n\n@media (min-width: 768px) {\n  .qty-control { width: 120px; }\n  .price-col { width: 100px; }\n  .remove-col { width: 50px; }\n}\n\n.hover-danger {\n  transition: color 0.2s, transform 0.2s;\n}\n.hover-danger:hover {\n  color: #dc3545 !important;\n  transform: scale(1.1);\n}\n\n.sticky-summary {\n  position: sticky;\n  top: 130px;\n}\n\n.border-dashed {\n  border-style: dashed !important;\n}\n\n.checkout-btn {\n  transition: transform 0.2s;\n}\n.checkout-btn:hover {\n  transform: translateY(-2px);\n  background-color: #000;\n}\n\n@media (max-width: 767px) {\n  .cart-item-row {\n    flex-wrap: wrap;\n    text-align: center;\n    justify-content: center;\n  }\n  .flex-grow-1 {\n    text-align: center;\n    width: 100%;\n  }\n  .qty-control, .price-col {\n    margin: 5px 0;\n  }\n  .remove-col {\n    width: 100%;\n    text-align: center !important;\n    margin-top: 10px;\n  }\n}\n</style>","/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/CheckoutView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/OrderDetailView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/components/Card.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardOrderDetailView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardView.vue",[],{"ruleId":"136","severity":1,"message":"137","line":88,"column":31,"nodeType":"138","messageId":"139","endLine":88,"endColumn":34,"suggestions":"140"},{"ruleId":"136","severity":1,"message":"137","line":89,"column":34,"nodeType":"138","messageId":"139","endLine":89,"endColumn":37,"suggestions":"141"},{"ruleId":"136","severity":1,"message":"137","line":22,"column":20,"nodeType":"138","messageId":"139","endLine":22,"endColumn":23,"suggestions":"142"},{"ruleId":"136","severity":1,"message":"137","line":42,"column":27,"nodeType":"138"