d/client/src/store/index.ts",[],[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/HomeView.vue",[],[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/CategoryView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/AboutView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/LoginView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/ProfileView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/ProductDetailsView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/RegisterView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/SettingsView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/OrdersView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/NotFoundView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/components/Navbar.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/components/Carousel.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/store/UserStore.ts",["108","109","110"],"import {defineStore} from 'pinia';\nimport axios from \"axios\";\n\nexport const useUserStore = defineStore('User',{\n    state: () => ({\n        status:\"undefined\",\n        user:{} as any,\n        cart:[] as any[]\n    }),\n    actions:{\n        authVerify() {\n            axios.get(\"http://localhost:8080/api/checkLogin\", { withCredentials: true })\n            .then(res => {\n            if (res.data.status === 'success') {\n            this.user = res.data.user; \n            this.status = 'success';\n            }\n            else{\n            this.user = {};\n            this.status = 'error';\n            }\n            })\n            .catch(err => console.error(\"Kullanıcı doğrulama hatası:\", err));\n        },\n        sessionDestroy(){\n            this.user = {};\n        },\n        addToCart(product:any){\n            const item = this.cart.find(p => p.product_id == product.product_id);\n            \n            if(item){\n                item.qty++;\n            }\n            else{\n\n                this.cart.push({\n                    product_id:product.product_id,\n                    title:product.title,\n                    price:product.price,\n                    thumbnail:product.thumbnail,\n                    qty:1\n                });\n            }\n        }\n    }\n\n})","/home/aliberk/Masaüstü/ecommerce/frontend/client/src/store/ProductsStore.ts",["111","112"],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/store/OrdersStore.ts",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardProductsView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardOrdersView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardAddProductView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardProductEditView.vue",[],"/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/CartView.vue",["113","114"],"<template>\n  <section class=\"container my-5\">\n    <h2 class=\"mb-4\">Sepetim</h2>\n\n    <div v-if=\"UserStore.cart.length === 0\">\n      <p>Sepetiniz şu anda boş.</p>\n      <router-link to=\"/\" class=\"btn btn-primary mt-3\">Alışverişe Başla</router-link>\n    </div>\n\n    <div v-else>\n      <div v-for=\"item in UserStore.cart\" :key=\"item.id\" class=\"d-flex justify-content-between align-items-center mb-3 p-2 shadow-sm rounded\">\n        <img :src=\"item.thumbnail\" alt=\"Ürün\" style=\"width:80px; height:80px; object-fit:cover;\">\n        \n        <div class=\"flex-grow-1 ms-3 d-flex flex-column\">\n          <p class=\"mb-1\">{{ item.title }}</p>\n          <small>{{ item.price }} TL</small>\n          <div class=\"d-flex align-items-center mt-1 qty-input-wrapper\">\n            <button class=\"btn btn-outline-secondary btn-sm\" @click=\"decreaseQty(item)\">-</button>\n            <input type=\"number\" v-model.number=\"item.qty\" min=\"1\" class=\"form-control form-control-sm text-center mx-1\" style=\"width:60px;\">\n            <button class=\"btn btn-outline-secondary btn-sm\" @click=\"increaseQty(item)\">+</button>\n          </div>\n        </div>\n\n        <div>\n          <strong>{{ item.qty * item.price }} TL</strong>\n        </div>\n      </div>\n\n      <hr>\n      <div class=\"d-flex justify-content-between align-items-center mt-3\">\n        <h4>Toplam: {{ totalPrice }} TL</h4>\n        <div>\n          <router-link to=\"/checkout\" class=\"btn btn-success me-2\">Alışverişi Tamamla</router-link>\n          <router-link to=\"/\" class=\"btn btn-primary\">Alışverişe Devam Et</router-link>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script lang=\"ts\">\nimport { defineComponent, computed } from 'vue';\nimport { useUserStore } from '../store/UserStore';\n\nexport default defineComponent({\n  name: 'CartView',\n  setup() {\n    const UserStore = useUserStore();\n\n    const increaseQty = (item: any) => {\n      item.qty += 1;\n    };\n\n    const decreaseQty = (item: any) => {\n      item.qty = Math.max(1, item.qty - 1);\n    };\n\n    const totalPrice = computed(() =>\n      UserStore.cart.reduce((acc, item) => acc + item.price * item.qty, 0)\n    );\n\n    return { UserStore, increaseQty, decreaseQty, totalPrice };\n  }\n});\n</script>\n\n<style scoped>\n.qty-input-wrapper button {\n  border-radius: 5px;\n  padding: 0 0.5rem;\n  font-weight: bold;\n}\n\n.qty-input-wrapper input {\n  border-radius: 5px;\n  border: 1px solid #ced4da;\n  height: 30px;\n}\n</style>\n","/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/CheckoutView.vue",[],{"ruleId":"115","severity":1,"message":"116","line":7,"column":20,"nodeType":"117","messageId":"118","endLine":7,"endColumn":23,"suggestions":"119"},{"ruleId":"115","severity":1,"message":"116","line":8,"column":20,"nodeType":"117","messageId":"118","endLine":8,"endColumn":23,"suggestions":"120"}