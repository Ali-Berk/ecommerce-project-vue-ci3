{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: \"ProfileView\",\n  props: ['user'],\n  data() {\n    return {\n      isEditing: false,\n      // Form verilerini prop'tan kopyalıyoruz ki düzenleyebilelim\n      form: {\n        name: this.user?.name || '',\n        mail: this.user?.mail || '',\n        phone: this.user?.phone || '',\n        birthDate: this.user?.birthDate || '',\n        gender: this.user?.gender || 'male'\n      }\n    };\n  },\n  watch: {\n    // User prop'u asenkron gelirse formu güncelle\n    user: {\n      handler(newVal) {\n        if (newVal) {\n          this.form = {\n            ...this.form,\n            ...newVal\n          };\n        }\n      },\n      deep: true\n    }\n  },\n  methods: {\n    logout() {\n      // Logout işlemleri...\n      axios.get('http://localhost:8080/api/logout').then(() => location.reload());\n    },\n    saveProfile() {\n      // API'ye kaydetme isteği burada atılır\n      console.log(\"Kaydedilen veriler:\", this.form);\n      this.isEditing = false;\n      // Opsiyonel: Kullanıcıya başarı mesajı göster\n    },\n    cancelEdit() {\n      // Değişiklikleri geri al\n      this.form = {\n        ...this.form,\n        ...this.user\n      };\n      this.isEditing = false;\n    }\n  }\n};","map":{"version":3,"names":["axios","name","props","data","isEditing","form","user","mail","phone","birthDate","gender","watch","handler","newVal","deep","methods","logout","get","then","location","reload","saveProfile","console","log","cancelEdit"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/ProfileView.vue"],"sourcesContent":["<template>\n  <div class=\"profile-page-wrapper\">\n    <div class=\"container py-5\">\n      <div class=\"row g-4\">\n        \n        <div class=\"col-lg-3\">\n          <div class=\"sidebar-card bg-white shadow-sm rounded-4 p-4 sticky-top\">\n            \n            <div class=\"text-center mb-4 pb-4 border-bottom\">\n              <div class=\"position-relative d-inline-block mb-3\">\n                <img :src=\"user.avatar || 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png'\" \n                     class=\"avatar-img rounded-circle shadow-sm\">\n                <button class=\"btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0 border-2 border-white edit-avatar-btn\">\n                  <i class=\"bi bi-camera-fill\"></i>\n                </button>\n              </div>\n              <h5 class=\"fw-bold mb-1\">{{ user.name }}</h5>\n              <p class=\"text-muted small mb-0\">{{ user.mail }}</p>\n            </div>\n\n            <nav class=\"nav flex-column gap-2 profile-nav\">\n              <router-link to=\"/profile\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-person\"></i></span>\n                Profil Bilgileri\n              </router-link>\n              <router-link to=\"/orders\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-box-seam\"></i></span>\n                Siparişlerim\n              </router-link>\n              <router-link to=\"/address\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-geo-alt\"></i></span>\n                Adreslerim\n              </router-link>\n              <router-link to=\"/favorites\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-heart\"></i></span>\n                Favorilerim\n              </router-link>\n              <hr class=\"my-2 opacity-10\">\n              <button @click=\"logout\" class=\"nav-link text-danger w-100 text-start\">\n                <span class=\"icon-wrapper bg-danger-subtle text-danger\"><i class=\"bi bi-box-arrow-right\"></i></span>\n                Çıkış Yap\n              </button>\n            </nav>\n          </div>\n        </div>\n\n        <div class=\"col-lg-9\">\n          \n          <div class=\"row g-3 mb-4\">\n            <div class=\"col-md-4\">\n              <div class=\"stat-card bg-primary text-white p-3 rounded-4 d-flex align-items-center justify-content-between\">\n                <div>\n                  <h3 class=\"fw-bold mb-0\">12</h3>\n                  <small class=\"opacity-75\">Aktif Sipariş</small>\n                </div>\n                <i class=\"bi bi-box-seam fs-1 opacity-50\"></i>\n              </div>\n            </div>\n            <div class=\"col-md-4\">\n              <div class=\"stat-card bg-white shadow-sm p-3 rounded-4 d-flex align-items-center justify-content-between border\">\n                <div>\n                  <h3 class=\"fw-bold mb-0 text-dark\">5</h3>\n                  <small class=\"text-muted\">Favori Ürün</small>\n                </div>\n                <i class=\"bi bi-heart fs-1 text-danger opacity-50\"></i>\n              </div>\n            </div>\n            <div class=\"col-md-4\">\n              <div class=\"stat-card bg-white shadow-sm p-3 rounded-4 d-flex align-items-center justify-content-between border\">\n                <div>\n                  <h3 class=\"fw-bold mb-0 text-dark\">150₺</h3>\n                  <small class=\"text-muted\">İndirim Kuponu</small>\n                </div>\n                <i class=\"bi bi-ticket-perforated fs-1 text-warning opacity-50\"></i>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"bg-white shadow-sm rounded-4 p-4 p-md-5\">\n            <div class=\"d-flex justify-content-between align-items-center mb-4\">\n              <h4 class=\"fw-bold mb-0\">Kişisel Bilgiler</h4>\n              <button class=\"btn btn-light rounded-pill px-4 text-primary fw-bold\" v-if=\"!isEditing\" @click=\"isEditing = true\">\n                <i class=\"bi bi-pencil me-2\"></i>Düzenle\n              </button>\n            </div>\n\n            <form @submit.prevent=\"saveProfile\">\n              <div class=\"row g-4\">\n                \n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"text\" class=\"form-control\" id=\"nameInput\" placeholder=\"Adınız\" v-model=\"form.name\" :disabled=\"!isEditing\">\n                    <label for=\"nameInput\">Ad Soyad</label>\n                  </div>\n                </div>\n\n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"email\" class=\"form-control\" id=\"emailInput\" placeholder=\"Email\" v-model=\"form.mail\" disabled> <label for=\"emailInput\">E-Posta Adresi</label>\n                    <small class=\"text-muted ms-2 mt-1 d-block\" v-if=\"isEditing\"><i class=\"bi bi-lock-fill me-1\"></i>E-posta değiştirilemez</small>\n                  </div>\n                </div>\n\n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"tel\" class=\"form-control\" id=\"phoneInput\" placeholder=\"Telefon\" v-model=\"form.phone\" :disabled=\"!isEditing\">\n                    <label for=\"phoneInput\">Telefon Numarası</label>\n                  </div>\n                </div>\n\n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"date\" class=\"form-control\" id=\"birthInput\" v-model=\"form.birthDate\" :disabled=\"!isEditing\">\n                    <label for=\"birthInput\">Doğum Tarihi</label>\n                  </div>\n                </div>\n\n                <div class=\"col-12\">\n                   <label class=\"d-block text-muted small fw-bold mb-2\">Cinsiyet</label>\n                   <div class=\"d-flex gap-3\">\n                     <div class=\"form-check custom-radio\">\n                        <input class=\"form-check-input\" type=\"radio\" name=\"gender\" id=\"genderM\" value=\"male\" v-model=\"form.gender\" :disabled=\"!isEditing\">\n                        <label class=\"form-check-label\" for=\"genderM\">Erkek</label>\n                     </div>\n                     <div class=\"form-check custom-radio\">\n                        <input class=\"form-check-input\" type=\"radio\" name=\"gender\" id=\"genderF\" value=\"female\" v-model=\"form.gender\" :disabled=\"!isEditing\">\n                        <label class=\"form-check-label\" for=\"genderF\">Kadın</label>\n                     </div>\n                   </div>\n                 </div>\n\n              </div>\n\n              <div class=\"d-flex gap-3 mt-5\" v-if=\"isEditing\">\n                <button type=\"submit\" class=\"btn btn-dark rounded-pill px-5 py-2 fw-bold\">Değişiklikleri Kaydet</button>\n                <button type=\"button\" class=\"btn btn-outline-secondary rounded-pill px-4 py-2\" @click=\"cancelEdit\">İptal</button>\n              </div>\n            </form>\n\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: \"ProfileView\",\n  props: ['user'],\n  data() {\n    return {\n      isEditing: false,\n      // Form verilerini prop'tan kopyalıyoruz ki düzenleyebilelim\n      form: {\n        name: this.user?.name || '',\n        mail: this.user?.mail || '',\n        phone: this.user?.phone || '',\n        birthDate: this.user?.birthDate || '',\n        gender: this.user?.gender || 'male'\n      }\n    };\n  },\n  watch: {\n    // User prop'u asenkron gelirse formu güncelle\n    user: {\n      handler(newVal) {\n        if(newVal) {\n          this.form = { ...this.form, ...newVal };\n        }\n      },\n      deep: true\n    }\n  },\n  methods: {\n    logout() {\n      // Logout işlemleri...\n       axios.get('http://localhost:8080/api/logout')\n        .then(() => location.reload());\n    },\n    saveProfile() {\n      // API'ye kaydetme isteği burada atılır\n      console.log(\"Kaydedilen veriler:\", this.form);\n      this.isEditing = false;\n      // Opsiyonel: Kullanıcıya başarı mesajı göster\n    },\n    cancelEdit() {\n      // Değişiklikleri geri al\n      this.form = { ...this.form, ...this.user };\n      this.isEditing = false;\n    }\n  }\n}\n</script>\n\n<style scoped>\n.profile-page-wrapper {\n  background-color: #f3f4f6;\n  min-height: 100vh;\n}\n\n/* Sidebar */\n.avatar-img {\n  width: 100px;\n  height: 100px;\n  object-fit: cover;\n  border: 4px solid #fff;\n}\n\n.edit-avatar-btn {\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.8rem;\n}\n\n.profile-nav .nav-link {\n  color: #64748b;\n  font-weight: 500;\n  padding: 12px 15px;\n  border-radius: 12px;\n  transition: all 0.2s;\n  display: flex;\n  align-items: center;\n}\n\n.profile-nav .icon-wrapper {\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  background-color: #f1f5f9;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-right: 12px;\n  color: #475569;\n  transition: all 0.2s;\n}\n\n.profile-nav .nav-link:hover, \n.profile-nav .router-link-exact-active {\n  background-color: #fff;\n  color: #000;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.05);\n}\n\n.profile-nav .nav-link:hover .icon-wrapper,\n.profile-nav .router-link-exact-active .icon-wrapper {\n  background-color: #000;\n  color: #fff;\n}\n\n/* İstatistik Kartları */\n.stat-card {\n  transition: transform 0.2s;\n}\n.stat-card:hover {\n  transform: translateY(-5px);\n}\n\n/* Form Elemanları */\n.custom-form-floating .form-control {\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n  background-color: #f8fafc;\n}\n\n.custom-form-floating .form-control:focus {\n  background-color: #fff;\n  border-color: #000;\n  box-shadow: 0 0 0 4px rgba(0,0,0,0.05);\n}\n\n.custom-form-floating .form-control:disabled {\n  background-color: #f1f5f9;\n  opacity: 0.7;\n  border: none;\n}\n\n.custom-form-floating label {\n  color: #94a3b8;\n}\n\n/* Radio Button */\n.custom-radio .form-check-input:checked {\n  background-color: #000;\n  border-color: #000;\n}\n\n.sticky-top {\n  top: 100000px !important; /* Navbar payı */\n  z-index: 1;\n}\n</style>"],"mappings":"AAmJA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE,CAAC,MAAM,CAAC;EACfC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,KAAK;MAChB;MACAC,IAAI,EAAE;QACJJ,IAAI,EAAE,IAAI,CAACK,IAAI,EAAEL,IAAG,IAAK,EAAE;QAC3BM,IAAI,EAAE,IAAI,CAACD,IAAI,EAAEC,IAAG,IAAK,EAAE;QAC3BC,KAAK,EAAE,IAAI,CAACF,IAAI,EAAEE,KAAI,IAAK,EAAE;QAC7BC,SAAS,EAAE,IAAI,CAACH,IAAI,EAAEG,SAAQ,IAAK,EAAE;QACrCC,MAAM,EAAE,IAAI,CAACJ,IAAI,EAAEI,MAAK,IAAK;MAC/B;IACF,CAAC;EACH,CAAC;EACDC,KAAK,EAAE;IACL;IACAL,IAAI,EAAE;MACJM,OAAOA,CAACC,MAAM,EAAE;QACd,IAAGA,MAAM,EAAE;UACT,IAAI,CAACR,IAAG,GAAI;YAAE,GAAG,IAAI,CAACA,IAAI;YAAE,GAAGQ;UAAO,CAAC;QACzC;MACF,CAAC;MACDC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACP;MACChB,KAAK,CAACiB,GAAG,CAAC,kCAAkC,EAC1CC,IAAI,CAAC,MAAMC,QAAQ,CAACC,MAAM,CAAC,CAAC,CAAC;IAClC,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ;MACAC,OAAO,CAACC,GAAG,CAAC,qBAAqB,EAAE,IAAI,CAAClB,IAAI,CAAC;MAC7C,IAAI,CAACD,SAAQ,GAAI,KAAK;MACtB;IACF,CAAC;IACDoB,UAAUA,CAAA,EAAG;MACX;MACA,IAAI,CAACnB,IAAG,GAAI;QAAE,GAAG,IAAI,CAACA,IAAI;QAAE,GAAG,IAAI,CAACC;MAAK,CAAC;MAC1C,IAAI,CAACF,SAAQ,GAAI,KAAK;IACxB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}