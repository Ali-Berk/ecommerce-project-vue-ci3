{"ast":null,"code":"import { useOrdersStore } from '@/store/OrdersStore';\nexport default {\n  data() {\n    return {\n      isLoading: true\n    };\n  },\n  computed: {\n    OrdersStore() {\n      return useOrdersStore();\n    }\n  },\n  methods: {\n    // Sipariş durumuna göre renk sınıfı döndüren fonksiyon\n    getStatusClass(status) {\n      const s = status.toLowerCase();\n      if (s.includes('tamam') || s.includes('teslim')) return 'bg-success-subtle text-success';\n      if (s.includes('kargo') || s.includes('yol')) return 'bg-info-subtle text-info';\n      if (s.includes('iptal')) return 'bg-danger-subtle text-danger';\n      return 'bg-warning-subtle text-warning'; // Beklemede vb.\n    }\n  },\n  async mounted() {\n    // Yükleme animasyonunu göstermek için ufak bir bekleme süresi simülasyonu veya await\n    await this.OrdersStore.get_orders();\n    this.isLoading = false;\n  }\n};","map":{"version":3,"names":["useOrdersStore","data","isLoading","computed","OrdersStore","methods","getStatusClass","status","s","toLowerCase","includes","mounted","get_orders"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/OrdersView.vue"],"sourcesContent":["<template>\n  <div class=\"profile-page-wrapper\">\n    <div class=\"container pb-5\">\n      <div class=\"row justify-content-center\">\n        <div class=\"col-lg-10\">\n          \n          <div class=\"d-flex flex-column flex-md-row justify-content-between align-items-center mb-4\">\n            <h3 class=\"fw-bold mb-3 mb-md-0\">Siparişlerim</h3>\n            \n            <div class=\"d-flex gap-2\">\n              <button class=\"btn btn-dark rounded-pill px-4 btn-sm fw-medium\">Tümü</button>\n              <button class=\"btn btn-white border rounded-pill px-4 btn-sm fw-medium text-muted\">Devam Eden</button>\n              <button class=\"btn btn-white border rounded-pill px-4 btn-sm fw-medium text-muted\">Tamamlanan</button>\n            </div>\n          </div>\n\n          <div v-if=\"isLoading\" class=\"text-center py-5\">\n            <div class=\"spinner-border text-primary\" role=\"status\"></div>\n            <p class=\"text-muted mt-2\">Siparişleriniz getiriliyor...</p>\n          </div>\n\n          <div v-else-if=\"OrdersStore.status_data === 'error'\" class=\"alert alert-danger rounded-4 shadow-sm border-0 d-flex align-items-center gap-3\">\n            <i class=\"bi bi-exclamation-triangle-fill fs-4\"></i>\n            <div>\n              <strong>Bir hata oluştu.</strong> Sipariş verileri yüklenemedi.\n            </div>\n          </div>\n\n          <div v-else-if=\"OrdersStore.order_data.length === 0\" class=\"text-center py-5 bg-white rounded-4 shadow-sm\">\n             <div class=\"bg-light rounded-circle d-inline-flex p-4 mb-3\">\n                <i class=\"bi bi-bag-x fs-1 text-muted\"></i>\n             </div>\n             <h4 class=\"fw-bold\">Henüz siparişiniz yok.</h4>\n             <p class=\"text-muted mb-4\">Alışverişe başlayıp favori ürünlerinizi hemen sipariş verebilirsiniz.</p>\n             <router-link to=\"/\" class=\"btn btn-primary rounded-pill px-5 py-2 fw-bold\">Alışverişe Başla</router-link>\n          </div>\n\n          <div v-else class=\"d-flex flex-column gap-4\">\n            \n            <div \n              v-for=\"order in OrdersStore.order_data\" \n              :key=\"order.order_id\" \n              class=\"order-card bg-white rounded-4 shadow-sm overflow-hidden border\"\n            >\n              <div class=\"card-header-custom p-4 border-bottom bg-light-subtle d-flex flex-wrap gap-3 justify-content-between align-items-center\">\n                <div class=\"d-flex gap-4 align-items-center\">\n                  <div class=\"d-flex align-items-center gap-2\">\n                    <div class=\"icon-box bg-white border rounded-circle text-primary\">\n                      <i class=\"bi bi-calendar3\"></i>\n                    </div>\n                    <div>\n                      <small class=\"text-muted d-block fw-bold\" style=\"font-size: 0.7rem;\">SİPARİŞ TARİHİ</small>\n                      <span class=\"fw-medium text-dark\">24 Ocak 2026</span> </div>\n                  </div>\n\n                  <div class=\"d-none d-sm-block border-start ps-4\">\n                    <small class=\"text-muted d-block fw-bold\" style=\"font-size: 0.7rem;\">SİPARİŞ NO</small>\n                    <span class=\"fw-medium text-dark font-monospace\">#{{ order.order_id }}</span>\n                  </div>\n                </div>\n\n                <div>\n                   <span class=\"badge rounded-pill py-2 px-3 fw-bold status-badge\" :class=\"getStatusClass(order.status)\">\n                      {{ order.status }}\n                   </span>\n                </div>\n              </div>\n\n              <div class=\"p-4\">\n                <div class=\"row align-items-center g-4\">\n                  \n                  <div class=\"col-md-8\">\n                    <div class=\"d-flex gap-3 align-items-start\">\n                      <div class=\"product-icon-placeholder bg-light rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 text-muted\">\n                        <i class=\"bi bi-box-seam fs-3\"></i>\n                      </div>\n                      \n                      <div>\n                        <h6 class=\"fw-bold text-dark mb-1\">Teslimat Adresi: <span class=\"fw-normal text-muted\">{{ order.order_address }}</span></h6>\n                        <p class=\"text-muted mb-0 small\">\n                          <i class=\"bi bi-basket me-1\"></i>\n                          İçerik: {{ order.product_titles }}\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div class=\"col-md-4 text-md-end\">\n                    <small class=\"text-muted fw-bold\">TOPLAM TUTAR</small>\n                    <h4 class=\"fw-bold text-primary mb-3\">{{ order.total_price }} ₺</h4>\n                    \n                    <router-link :to=\"'orders/'+order.order_id\" class=\"btn btn-outline-dark rounded-pill w-100 stretched-link-custom\">\n                      Sipariş Detayı <i class=\"bi bi-arrow-right ms-2\"></i>\n                    </router-link>\n                  </div>\n\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { useOrdersStore } from '@/store/OrdersStore';\n\nexport default {\n  data() {\n    return {\n      isLoading: true\n    };\n  },\n  computed: {\n    OrdersStore() {\n      return useOrdersStore();\n    },\n  },\n  methods: {\n    // Sipariş durumuna göre renk sınıfı döndüren fonksiyon\n    getStatusClass(status) {\n      const s = status.toLowerCase();\n      if (s.includes('tamam') || s.includes('teslim')) return 'bg-success-subtle text-success';\n      if (s.includes('kargo') || s.includes('yol')) return 'bg-info-subtle text-info';\n      if (s.includes('iptal')) return 'bg-danger-subtle text-danger';\n      return 'bg-warning-subtle text-warning'; // Beklemede vb.\n    }\n  },\n  async mounted() {\n    // Yükleme animasyonunu göstermek için ufak bir bekleme süresi simülasyonu veya await\n    await this.OrdersStore.get_orders();\n    this.isLoading = false;\n  },\n};\n</script>\n\n<style scoped>\n/* Sayfa Yapısı */\n.profile-page-wrapper {\n  background-color: #f8f9fa;\n  min-height: 100vh;\n  padding-top: 120px; /* Navbar boşluğu */\n}\n\n/* Sipariş Kartı */\n.order-card {\n  transition: transform 0.2s, box-shadow 0.2s;\n  border-color: #eef1f6 !important;\n}\n\n.order-card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;\n}\n\n/* İkon Kutusu (Tarih yanında) */\n.icon-box {\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Ürün Resmi Yer Tutucu */\n.product-icon-placeholder {\n  width: 60px;\n  height: 60px;\n}\n\n/* Status Badge */\n.status-badge {\n  font-size: 0.8rem;\n  letter-spacing: 0.5px;\n}\n\n/* Buton Stilleri */\n.btn-white {\n  background-color: #fff;\n}\n.btn-white:hover {\n  background-color: #f8f9fa;\n  border-color: #dee2e6;\n}\n\n/* Responsive Düzenlemeler */\n@media (max-width: 768px) {\n  .order-card .card-header-custom {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .order-card .col-md-4 {\n    text-align: left !important;\n    border-top: 1px dashed #dee2e6;\n    padding-top: 1rem;\n    margin-top: 0.5rem;\n  }\n  .stretched-link-custom {\n    width: auto !important;\n    display: inline-flex;\n  }\n}\n</style>"],"mappings":"AA6GA,SAASA,cAAa,QAAS,qBAAqB;AAEpD,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,OAAOJ,cAAc,CAAC,CAAC;IACzB;EACF,CAAC;EACDK,OAAO,EAAE;IACP;IACAC,cAAcA,CAACC,MAAM,EAAE;MACrB,MAAMC,CAAA,GAAID,MAAM,CAACE,WAAW,CAAC,CAAC;MAC9B,IAAID,CAAC,CAACE,QAAQ,CAAC,OAAO,KAAKF,CAAC,CAACE,QAAQ,CAAC,QAAQ,CAAC,EAAE,OAAO,gCAAgC;MACxF,IAAIF,CAAC,CAACE,QAAQ,CAAC,OAAO,KAAKF,CAAC,CAACE,QAAQ,CAAC,KAAK,CAAC,EAAE,OAAO,0BAA0B;MAC/E,IAAIF,CAAC,CAACE,QAAQ,CAAC,OAAO,CAAC,EAAE,OAAO,8BAA8B;MAC9D,OAAO,gCAAgC,EAAE;IAC3C;EACF,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd;IACA,MAAM,IAAI,CAACP,WAAW,CAACQ,UAAU,CAAC,CAAC;IACnC,IAAI,CAACV,SAAQ,GAAI,KAAK;EACxB;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}