{"ast":null,"code":"import axios from 'axios';\nimport { useOrdersStore } from '@/store/OrdersStore';\nexport default {\n  name: \"ProfileView\",\n  props: ['user'],\n  data() {\n    return {\n      isEditing: false,\n      form: {\n        name: this.user?.name || '',\n        mail: this.user?.mail || '',\n        tel: this.user?.tel || '',\n        birthDate: this.user?.birthDate || '',\n        info: this.user?.info || 'SMS'\n      }\n    };\n  },\n  watch: {\n    user: {\n      handler(newVal) {\n        if (newVal) {\n          this.form = {\n            ...this.form,\n            ...newVal\n          };\n        }\n      },\n      deep: true\n    }\n  },\n  computed: {\n    OrdersStore() {\n      return useOrdersStore();\n    }\n  },\n  methods: {\n    logout() {\n      axios.get('http://localhost:8080/api/logout').then(() => location.reload());\n    },\n    saveProfile() {\n      console.log(\"Kaydedilen veriler:\", this.form);\n      this.isEditing = false;\n    },\n    cancelEdit() {\n      this.form = {\n        ...this.form,\n        ...this.user\n      };\n      this.isEditing = false;\n    }\n  }\n};","map":{"version":3,"names":["axios","useOrdersStore","name","props","data","isEditing","form","user","mail","tel","birthDate","info","watch","handler","newVal","deep","computed","OrdersStore","methods","logout","get","then","location","reload","saveProfile","console","log","cancelEdit"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/ProfileView.vue"],"sourcesContent":["<template>\n  <div class=\"profile-page-wrapper\">\n    <div class=\"container pb-5\"> <div class=\"row g-4\">\n        \n        <div class=\"col-lg-3\">\n          <div class=\"sidebar-card bg-white shadow-sm rounded-4 p-4 sticky-menu\">\n            \n            <div class=\"text-center mb-4 pb-4 border-bottom\">\n              <div class=\"position-relative d-inline-block mb-3\">\n                <img :src=\"user.avatar || 'https://cdn-icons-png.flaticon.com/512/3135/3135715.png'\" \n                     class=\"avatar-img rounded-circle shadow-sm\">\n                <button class=\"btn btn-sm btn-primary rounded-circle position-absolute bottom-0 end-0 border-2 border-white edit-avatar-btn\">\n                  <i class=\"bi bi-camera-fill\"></i>\n                </button>\n              </div>\n              <h5 class=\"fw-bold mb-1\">{{ user.name }}</h5>\n              <p class=\"text-muted small mb-0\">{{ user.mail }}</p>\n            </div>\n\n            <nav class=\"nav flex-column gap-2 profile-nav\">\n              <router-link to=\"/profile\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-person\"></i></span>\n                Profil Bilgileri\n              </router-link>\n              <router-link to=\"/orders\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-box-seam\"></i></span>\n                Siparişlerim\n              </router-link>\n              <router-link to=\"/address\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-geo-alt\"></i></span>\n                Adreslerim\n              </router-link>\n              <router-link to=\"/favorites\" class=\"nav-link\">\n                <span class=\"icon-wrapper\"><i class=\"bi bi-heart\"></i></span>\n                Favorilerim\n              </router-link>\n              <hr class=\"my-2 opacity-10\">\n              <button @click=\"logout\" class=\"nav-link text-danger w-100 text-start\">\n                <span class=\"icon-wrapper bg-danger-subtle text-danger\"><i class=\"bi bi-box-arrow-right\"></i></span>\n                Çıkış Yap\n              </button>\n            </nav>\n          </div>\n        </div>\n\n        <div class=\"col-lg-9\">\n          \n          <div class=\"row g-3 mb-4\">\n            <div class=\"col-md-4\">\n              <div class=\"stat-card bg-primary text-white p-3 rounded-4 d-flex align-items-center justify-content-between\">\n                <div>\n                  <h3 class=\"fw-bold mb-0\">{{ OrdersStore.activeOrderCount}}</h3>\n                  <small class=\"opacity-75\">Aktif Sipariş</small>\n                </div>\n                <i class=\"bi bi-box-seam fs-1 opacity-50\"></i>\n              </div>\n            </div>\n            <div class=\"col-md-4\">\n              <div class=\"stat-card bg-white shadow-sm p-3 rounded-4 d-flex align-items-center justify-content-between border\">\n                <div>\n                  <h3 class=\"fw-bold mb-0 text-dark\">5</h3>\n                  <small class=\"text-muted\">Favori Ürün</small>\n                </div>\n                <i class=\"bi bi-heart fs-1 text-danger opacity-50\"></i>\n              </div>\n            </div>\n            <div class=\"col-md-4\">\n              <div class=\"stat-card bg-white shadow-sm p-3 rounded-4 d-flex align-items-center justify-content-between border\">\n                <div>\n                  <h3 class=\"fw-bold mb-0 text-dark\">150₺</h3>\n                  <small class=\"text-muted\">İndirim Kuponu</small>\n                </div>\n                <i class=\"bi bi-ticket-perforated fs-1 text-warning opacity-50\"></i>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"bg-white shadow-sm rounded-4 p-4 p-md-5\">\n            <div class=\"d-flex justify-content-between align-items-center mb-4\">\n              <h4 class=\"fw-bold mb-0\">Kişisel Bilgiler</h4>\n              <button class=\"btn btn-light rounded-pill px-4 text-primary fw-bold\" v-if=\"!isEditing\" @click=\"isEditing = true\">\n                <i class=\"bi bi-pencil me-2\"></i>Düzenle\n              </button>\n            </div>\n\n            <form @submit.prevent=\"saveProfile\">\n              <div class=\"row g-4\">\n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"text\" class=\"form-control\" id=\"nameInput\" placeholder=\"Adınız\" v-model=\"form.name\" :disabled=\"!isEditing\">\n                    <label for=\"nameInput\">Ad Soyad</label>\n                  </div>\n                </div>\n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"email\" class=\"form-control\" id=\"emailInput\" placeholder=\"Email\" v-model=\"form.mail\" disabled>\n                    <label for=\"emailInput\">E-Posta Adresi</label>\n                  </div>\n                </div>\n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"tel\" class=\"form-control\" id=\"phoneInput\" placeholder=\"Telefon\" v-model=\"form.tel\" :disabled=\"!isEditing\">\n                    <label for=\"phoneInput\">Telefon Numarası</label>\n                  </div>\n                </div>\n                <div class=\"col-md-6\">\n                  <div class=\"form-floating custom-form-floating\">\n                    <input type=\"date\" class=\"form-control\" id=\"birthInput\" v-model=\"form.birthDate\" :disabled=\"!isEditing\">\n                    <label for=\"birthInput\">Doğum Tarihi</label>\n                  </div>\n                </div>\n                 <div class=\"col-12\">\n                   <label class=\"d-block text-muted small fw-bold mb-2\">Bilgilendirme Türü</label>\n                   <div class=\"d-flex gap-3\">\n                     <div class=\"form-check custom-radio\">\n                        <input class=\"form-check-input\" type=\"radio\" name=\"info\" id=\"Mail\" value=\"Mail\" v-model=\"form.info\" :disabled=\"!isEditing\">\n                        <label class=\"form-check-label\" for=\"Mail\">Mail</label>\n                     </div>\n                     <div class=\"form-check custom-radio\">\n                        <input class=\"form-check-input\" type=\"radio\" name=\"info\" id=\"SMS\" value=\"SMS\" v-model=\"form.info\" :disabled=\"!isEditing\">\n                        <label class=\"form-check-label\" for=\"SMS\">SMS</label>\n                     </div>\n                   </div>\n                   <label class=\"d-block text-muted small fw-bold mb-2\">Fatura Tipi</label>\n                   <div class=\"d-flex gap-3\">\n                     <div class=\"form-check custom-radio\">\n                        <input class=\"form-check-input\" type=\"radio\" name=\"billing_type\" id=\"sirket\" value=\"sirket\" v-model=\"form.billing_type\" :disabled=\"!isEditing\">\n                        <label class=\"form-check-label\" for=\"sirket\">Şirket</label>\n                     </div>\n                     <div class=\"form-check custom-radio\">\n                        <input class=\"form-check-input\" type=\"radio\" name=\"billing_type\" id=\"sahis\" value=\"sahis\" v-model=\"form.billing_type\" :disabled=\"!isEditing\">\n                        <label class=\"form-check-label\" for=\"sahis\">Şahıs</label>\n                     </div>\n                   </div>\n                 </div>\n              </div>\n\n              <div class=\"d-flex gap-3 mt-5\" v-if=\"isEditing\">\n                <button type=\"submit\" class=\"btn btn-dark rounded-pill px-5 py-2 fw-bold\">Değişiklikleri Kaydet</button>\n                <button type=\"button\" class=\"btn btn-outline-secondary rounded-pill px-4 py-2\" @click=\"cancelEdit\">İptal</button>\n              </div>\n            </form>\n\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\nimport { useOrdersStore } from '@/store/OrdersStore';\nexport default {\n  name: \"ProfileView\",\n  props: ['user'],\n  data() {\n    return {\n      isEditing: false,\n      form: {\n        name: this.user?.name || '',\n        mail: this.user?.mail || '',\n        tel: this.user?.tel || '',\n        birthDate: this.user?.birthDate || '',\n        info: this.user?.info || 'SMS'\n      }\n    };\n  },\n  watch: {\n    user: {\n      handler(newVal) {\n        if(newVal) {\n          this.form = { ...this.form, ...newVal };\n        }\n      },\n      deep: true\n    }\n  },\n  computed:{\n    OrdersStore() {\n      return useOrdersStore();\n    },\n  },\n  methods: {\n    logout() {\n       axios.get('http://localhost:8080/api/logout')\n        .then(() => location.reload());\n    },\n    saveProfile() {\n      \n      console.log(\"Kaydedilen veriler:\", this.form);\n      this.isEditing = false;\n    },\n    cancelEdit() {\n      this.form = { ...this.form, ...this.user };\n      this.isEditing = false;\n    }\n  }\n}\n</script>\n\n<style scoped>\n.profile-page-wrapper {\n  background-color: #f3f4f6;\n  min-height: 100vh;\n  padding-top: 120px; \n}\n\n/* Sidebar */\n.avatar-img {\n  width: 100px;\n  height: 100px;\n  object-fit: cover;\n  border: 4px solid #fff;\n}\n\n.edit-avatar-btn {\n  width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;\n}\n\n.profile-nav .nav-link {\n  color: #64748b; font-weight: 500; padding: 12px 15px; border-radius: 12px; transition: all 0.2s; display: flex; align-items: center;\n}\n\n.profile-nav .icon-wrapper {\n  width: 36px; height: 36px; border-radius: 10px; background-color: #f1f5f9; display: flex; align-items: center; justify-content: center; margin-right: 12px; color: #475569; transition: all 0.2s;\n}\n\n.profile-nav .nav-link:hover, .profile-nav .router-link-exact-active {\n  background-color: #fff; color: #000; box-shadow: 0 4px 15px rgba(0,0,0,0.05);\n}\n\n.profile-nav .nav-link:hover .icon-wrapper, .profile-nav .router-link-exact-active .icon-wrapper {\n  background-color: #000; color: #fff;\n}\n\n.stat-card { transition: transform 0.2s; }\n.stat-card:hover { transform: translateY(-5px); }\n\n.custom-form-floating .form-control { border: 1px solid #e2e8f0; border-radius: 12px; background-color: #f8fafc; }\n.custom-form-floating .form-control:focus { background-color: #fff; border-color: #000; box-shadow: 0 0 0 4px rgba(0,0,0,0.05); }\n.custom-form-floating .form-control:disabled { background-color: #f1f5f9; opacity: 0.7; border: none; }\n.custom-form-floating label { color: #94a3b8; }\n.custom-radio .form-check-input:checked { background-color: #000; border-color: #000; }\n\n.sticky-menu {\n  position: sticky;\n  top: 120px; \n  z-index: 1;\n}\n</style>"],"mappings":"AAuJA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,cAAa,QAAS,qBAAqB;AACpD,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE,CAAC,MAAM,CAAC;EACfC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,KAAK;MAChBC,IAAI,EAAE;QACJJ,IAAI,EAAE,IAAI,CAACK,IAAI,EAAEL,IAAG,IAAK,EAAE;QAC3BM,IAAI,EAAE,IAAI,CAACD,IAAI,EAAEC,IAAG,IAAK,EAAE;QAC3BC,GAAG,EAAE,IAAI,CAACF,IAAI,EAAEE,GAAE,IAAK,EAAE;QACzBC,SAAS,EAAE,IAAI,CAACH,IAAI,EAAEG,SAAQ,IAAK,EAAE;QACrCC,IAAI,EAAE,IAAI,CAACJ,IAAI,EAAEI,IAAG,IAAK;MAC3B;IACF,CAAC;EACH,CAAC;EACDC,KAAK,EAAE;IACLL,IAAI,EAAE;MACJM,OAAOA,CAACC,MAAM,EAAE;QACd,IAAGA,MAAM,EAAE;UACT,IAAI,CAACR,IAAG,GAAI;YAAE,GAAG,IAAI,CAACA,IAAI;YAAE,GAAGQ;UAAO,CAAC;QACzC;MACF,CAAC;MACDC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,QAAQ,EAAC;IACPC,WAAWA,CAAA,EAAG;MACZ,OAAOhB,cAAc,CAAC,CAAC;IACzB;EACF,CAAC;EACDiB,OAAO,EAAE;IACPC,MAAMA,CAAA,EAAG;MACNnB,KAAK,CAACoB,GAAG,CAAC,kCAAkC,EAC1CC,IAAI,CAAC,MAAMC,QAAQ,CAACC,MAAM,CAAC,CAAC,CAAC;IAClC,CAAC;IACDC,WAAWA,CAAA,EAAG;MAEZC,OAAO,CAACC,GAAG,CAAC,qBAAqB,EAAE,IAAI,CAACpB,IAAI,CAAC;MAC7C,IAAI,CAACD,SAAQ,GAAI,KAAK;IACxB,CAAC;IACDsB,UAAUA,CAAA,EAAG;MACX,IAAI,CAACrB,IAAG,GAAI;QAAE,GAAG,IAAI,CAACA,IAAI;QAAE,GAAG,IAAI,CAACC;MAAK,CAAC;MAC1C,IAAI,CAACF,SAAQ,GAAI,KAAK;IACxB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}