{"ast":null,"code":"import { useProductStore } from '../store/ProductsStore';\nimport ProductCard from '../components/ProductCard.vue'; // Kartı import ettik\n\nexport default {\n  name: \"HomeView\",\n  components: {\n    ProductCard\n  },\n  data() {\n    return {\n      randomProducts: [] // Rastgele ürünleri tutacak dizi\n    };\n  },\n  setup() {\n    const productStore = useProductStore();\n    return {\n      productStore\n    };\n  },\n  mounted() {\n    this.prepareShowcase();\n  },\n  methods: {\n    async prepareShowcase() {\n      // 1. Ürünler yüklü değilse yükle\n      if (this.productStore.products.length === 0) {\n        await this.productStore.loadCategory(); // Veya loadProducts() fonksiyonun neyse\n      }\n\n      // 2. Tüm ürünlerin kopyasını al\n      let all = [...this.productStore.products];\n\n      // 3. Diziyi Karıştır (Fisher-Yates Shuffle basit versiyonu)\n      all.sort(() => Math.random() - 0.5);\n\n      // 4. İlk 4 ürünü al ve ekrana bas\n      this.randomProducts = all.slice(0, 4);\n    }\n  }\n};","map":{"version":3,"names":["useProductStore","ProductCard","name","components","data","randomProducts","setup","productStore","mounted","prepareShowcase","methods","products","length","loadCategory","all","sort","Math","random","slice"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/components/Card.vue"],"sourcesContent":["<template>\n  <section class=\"home-container\">\n    \n    <section class=\"container my-5\">\n      <h3 class=\"mb-4 fw-bold\">Sizin İçin Seçtiklerimiz</h3>\n      \n      <div class=\"row g-4\">\n        <div \n          v-for=\"item in randomProducts\" \n          :key=\"item.product_id\" \n          class=\"col-lg-3 col-md-4 col-sm-6\"\n        >\n          <ProductCard :product=\"item\" />\n        </div>\n      </div>\n    </section>\n\n  </section>\n</template>\n\n<script>\nimport { useProductStore } from '../store/ProductsStore';\nimport ProductCard from '../components/ProductCard.vue'; // Kartı import ettik\n\nexport default {\n  name: \"HomeView\",\n  components: { ProductCard },\n  data() {\n    return {\n      randomProducts: [] // Rastgele ürünleri tutacak dizi\n    };\n  },\n  setup() {\n    const productStore = useProductStore();\n    return { productStore };\n  },\n  mounted() {\n    this.prepareShowcase();\n  },\n  methods: {\n    async prepareShowcase() {\n      // 1. Ürünler yüklü değilse yükle\n      if (this.productStore.products.length === 0) {\n        await this.productStore.loadCategory(); // Veya loadProducts() fonksiyonun neyse\n      }\n\n      // 2. Tüm ürünlerin kopyasını al\n      let all = [...this.productStore.products];\n\n      // 3. Diziyi Karıştır (Fisher-Yates Shuffle basit versiyonu)\n      all.sort(() => Math.random() - 0.5);\n\n      // 4. İlk 4 ürünü al ve ekrana bas\n      this.randomProducts = all.slice(0, 4);\n    }\n  }\n};\n</script>"],"mappings":"AAqBA,SAASA,eAAc,QAAS,wBAAwB;AACxD,OAAOC,WAAU,MAAO,+BAA+B,EAAE;;AAEzD,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEF;EAAY,CAAC;EAC3BG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE,EAAC,CAAE;IACrB,CAAC;EACH,CAAC;EACDC,KAAKA,CAAA,EAAG;IACN,MAAMC,YAAW,GAAIP,eAAe,CAAC,CAAC;IACtC,OAAO;MAAEO;IAAa,CAAC;EACzB,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC,CAAC;EACxB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,eAAeA,CAAA,EAAG;MACtB;MACA,IAAI,IAAI,CAACF,YAAY,CAACI,QAAQ,CAACC,MAAK,KAAM,CAAC,EAAE;QAC3C,MAAM,IAAI,CAACL,YAAY,CAACM,YAAY,CAAC,CAAC,EAAE;MAC1C;;MAEA;MACA,IAAIC,GAAE,GAAI,CAAC,GAAG,IAAI,CAACP,YAAY,CAACI,QAAQ,CAAC;;MAEzC;MACAG,GAAG,CAACC,IAAI,CAAC,MAAMC,IAAI,CAACC,MAAM,CAAC,IAAI,GAAG,CAAC;;MAEnC;MACA,IAAI,CAACZ,cAAa,GAAIS,GAAG,CAACI,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC;IACvC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}