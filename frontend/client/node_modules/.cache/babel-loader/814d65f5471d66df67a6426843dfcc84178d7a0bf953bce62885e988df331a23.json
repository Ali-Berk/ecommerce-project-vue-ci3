{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: \"RegisterView\",\n  data() {\n    return {\n      name: \"\",\n      email: \"\",\n      password: \"\",\n      tel: \"\",\n      isLoading: false\n    };\n  },\n  methods: {\n    async handleRegister() {\n      if (!this.name || !this.email || !this.password) return;\n      this.isLoading = true;\n      try {\n        const response = await axios.post('http://localhost:8080/api/register', {\n          name: this.name,\n          mail: this.email,\n          password: this.password,\n          tel: this.tel\n        });\n        if (response.data.status === 'success') {\n          alert(\"Kayıt başarılı! Giriş sayfasına yönlendiriliyorsunuz.\");\n          this.$router.push('/login');\n        } else {\n          alert(\"Kayıt başarısız: \" + (response.data.message || \"Bilinmeyen hata\"));\n        }\n      } catch (error) {\n        console.error(error);\n        alert(\"Bir hata oluştu.\");\n      } finally {\n        this.isLoading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","email","password","tel","isLoading","methods","handleRegister","response","post","mail","status","alert","$router","push","message","error","console"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/RegisterView.vue"],"sourcesContent":["<template>\n  <div class=\"row g-0 vh-100 bg-white\">\n    <div class=\"col-lg-6 d-none d-lg-block position-relative overflow-hidden\">\n      <img \n        src=\"https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2000&auto=format&fit=crop\" \n        alt=\"Register Cover\" \n        class=\"w-100 h-100 object-fit-cover\"\n      >\n      <div class=\"position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-25\"></div>\n      <div class=\"position-absolute bottom-0 start-0 p-5 text-white z-2\">\n        <h2 class=\"fw-bold\">Aramıza Katılın.</h2>\n        <p class=\"lead\">Size özel fırsatlardan yararlanmak için hemen üye olun.</p>\n      </div>\n    </div>\n\n    <div class=\"col-lg-6 d-flex align-items-center justify-content-center p-4\">\n      <div class=\"w-100\" style=\"max-width: 420px;\">\n        \n        <div class=\"text-center mb-5\">\n           <h3 class=\"fw-bold\">Hesap Oluştur</h3>\n           <p class=\"text-muted\">Bilgilerinizi girerek hızlıca kayıt olun.</p>\n        </div>\n        \n        <form @submit.prevent=\"handleRegister\" novalidate>\n          \n          <div class=\"form-floating mb-3\">\n            <input type=\"text\" class=\"form-control\" id=\"name\" v-model=\"name\" placeholder=\"Ad Soyad\" required>\n            <label for=\"name\">Ad Soyad</label>\n          </div>\n\n          <div class=\"form-floating mb-3\">\n            <input type=\"email\" class=\"form-control\" id=\"registerMail\" v-model=\"email\" placeholder=\"Email\" required>\n            <label for=\"registerMail\">E-posta Adresi</label>\n          </div>\n\n          <div class=\"form-floating mb-3\">\n            <input type=\"tel\" class=\"form-control\" id=\"tel\" v-model=\"tel\" placeholder=\"Telefon\" required>\n            <label for=\"tel\">Telefon</label>\n          </div>\n\n          <div class=\"form-floating mb-3\">\n            <input type=\"password\" class=\"form-control\" id=\"registerPassword\" v-model=\"password\" placeholder=\"Şifre\" required>\n            <label for=\"registerPassword\">Şifre</label>\n          </div>\n\n          <button type=\"submit\" class=\"btn btn-dark w-100 py-3 fw-bold rounded-pill shadow-sm login-btn\" :disabled=\"isLoading\">\n            <span v-if=\"isLoading\" class=\"spinner-border spinner-border-sm me-2\"></span>\n            {{ isLoading ? 'Kaydediliyor...' : 'Kayıt Ol' }}\n          </button>\n        </form>\n\n        <div class=\"text-center mt-4\">\n          <span class=\"text-muted\">Zaten hesabınız var mı?</span>\n          <router-link to=\"/login\" class=\"fw-bold text-decoration-none ms-1 text-primary\">Giriş Yap</router-link>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: \"RegisterView\",\n  data() {\n    return {\n      name: \"\",\n      email: \"\",\n      password: \"\",\n      tel: \"\",\n      isLoading: false\n    };\n  },\n  methods: {\n    async handleRegister() {\n      if(!this.name || !this.email || !this.password) return;\n\n      this.isLoading = true;\n      try {\n        const response = await axios.post('http://localhost:8080/api/register', {\n          name: this.name,\n          mail: this.email,\n          password: this.password,\n          tel: this.tel\n        });\n\n        if (response.data.status === 'success') {\n          alert(\"Kayıt başarılı! Giriş sayfasına yönlendiriliyorsunuz.\");\n          this.$router.push('/login');\n        } else {\n          alert(\"Kayıt başarısız: \" + (response.data.message || \"Bilinmeyen hata\"));\n        }\n      } catch (error) {\n        console.error(error);\n        alert(\"Bir hata oluştu.\");\n      } finally {\n        this.isLoading = false;\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n/* Login ile aynı stiller */\n.form-floating > .form-control:focus ~ label,\n.form-floating > .form-control:not(:placeholder-shown) ~ label {\n  color: #000;\n  opacity: 0.65;\n}\n.form-control:focus {\n  border-color: #000;\n  box-shadow: 0 0 0 0.25rem rgba(0, 0, 0, 0.1);\n}\n.login-btn {\n  transition: transform 0.2s;\n}\n.login-btn:hover:not(:disabled) {\n  transform: translateY(-2px);\n  background-color: #000;\n}\n</style>"],"mappings":";AA6DA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLD,IAAI,EAAE,EAAE;MACRE,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,GAAG,EAAE,EAAE;MACPC,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAG,CAAC,IAAI,CAACP,IAAG,IAAK,CAAC,IAAI,CAACE,KAAI,IAAK,C