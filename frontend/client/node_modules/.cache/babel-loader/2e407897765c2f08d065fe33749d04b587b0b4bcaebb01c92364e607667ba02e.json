{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: \"LoginView\",\n  emits: ['sessionCreate'],\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      submitted: false,\n      err: null,\n      isLoading: false\n    };\n  },\n  methods: {\n    async handleLogin() {\n      this.submitted = true;\n      this.err = null;\n      if (!this.email || !this.password) {\n        return;\n      }\n      this.isLoading = true;\n      let response;\n      try {\n        const {\n          data\n        } = await axios.post('http://localhost:8080/api/login', {\n          mail: this.email,\n          password: this.password\n        }, {\n          withCredentials: true\n        });\n        response = data;\n      } catch (error) {\n        response = {\n          'status': 'error',\n          'message': 'Çok Fazla İstek Atıldı.'\n        };\n        console.error(error);\n      } finally {\n        this.isLoading = false;\n      }\n      if (response?.status == \"success\") {\n        this.$router.push('/');\n        const store = await import('@/store/UserStore');\n        const UserStore = store.useUserStore();\n        UserStore.authVerify();\n        window.dispatchEvent(new CustomEvent('session-created'));\n      } else {\n        this.err = true;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","emits","data","email","password","submitted","err","isLoading","methods","handleLogin","response","post","mail","withCredentials","error","console","status","$router","push","store","UserStore","useUserStore","authVerify","window","dispatchEvent","CustomEvent"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/LoginView.vue"],"sourcesContent":["<template>\n  <div class=\"row g-0 vh-100 bg-white\">\n    <div class=\"col-lg-6 d-none d-lg-block position-relative overflow-hidden\">\n      <img \n        src=\"https://images.unsplash.com/photo-1586023492125-27b2c045efd7?q=80&w=2158&auto=format&fit=crop\" \n        alt=\"Login Cover\" \n        class=\"w-100 h-100 object-fit-cover\"\n      >\n      <div class=\"position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-25\"></div>\n      <div class=\"position-absolute bottom-0 start-0 p-5 text-white z-2\">\n        <h2 class=\"fw-bold\">Evinize Hoş Geldiniz.</h2>\n        <p class=\"lead\">Tarzınızı yansıtan mobilyalarla yaşam alanınızı yeniden keşfedin.</p>\n      </div>\n    </div>\n\n    <div class=\"col-lg-6 d-flex align-items-center justify-content-center p-4\">\n      <div class=\"w-100\" style=\"max-width: 420px;\">\n        \n        <div class=\"text-center mb-5\">\n          <i class=\"bi bi-box-seam fs-1 text-primary mb-3\"></i> <h3 class=\"fw-bold\">Giriş Yap</h3>\n          <p class=\"text-muted\">Devam etmek için hesabınıza giriş yapın.</p>\n        </div>\n        \n        <form @submit.prevent=\"handleLogin\" novalidate>\n          <div class=\"form-floating mb-3\">\n            <input\n              type=\"email\"\n              class=\"form-control\"\n              id=\"mail\"\n              v-model=\"email\"\n              placeholder=\"name@example.com\"\n              :class=\"{ 'is-invalid': submitted && !email }\"\n              required\n            />\n            <label for=\"mail\">E-posta Adresi</label>\n            <div class=\"invalid-feedback\" v-if=\"submitted && !email\">\n              Email alanı zorunludur.\n            </div>\n          </div>\n\n          <div class=\"form-floating mb-3\">\n            <input\n              type=\"password\"\n              class=\"form-control\"\n              id=\"password\"\n              v-model=\"password\"\n              placeholder=\"Şifre\"\n              :class=\"{ 'is-invalid': submitted && !password }\"\n              required\n            />\n            <label for=\"password\">Şifre</label>\n            <div class=\"invalid-feedback\" v-if=\"submitted && !password\">\n              Şifre alanı zorunludur.\n            </div>\n          </div>\n\n          <div class=\"alert alert-danger d-flex align-items-center\" v-if=\"err\">\n            <i class=\"bi bi-exclamation-circle-fill me-2\"></i>\n            <div>Kullanıcı Adı veya Şifre hatalı!</div>\n          </div>\n\n          <button type=\"submit\" class=\"btn btn-dark w-100 py-3 fw-bold rounded-pill shadow-sm login-btn\" :disabled=\"isLoading\">\n            <span v-if=\"isLoading\" class=\"spinner-border spinner-border-sm me-2\"></span>\n            {{ isLoading ? 'Giriş Yapılıyor...' : 'Giriş Yap' }}\n          </button>\n        </form>\n\n        <div class=\"text-center mt-4\">\n          <span class=\"text-muted\">Hesabınız yok mu?</span>\n          <router-link to=\"/register\" class=\"fw-bold text-decoration-none ms-1 text-primary\">Hesap Oluştur</router-link>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: \"LoginView\",\n  emits: ['sessionCreate'],\n  data() {\n    return {\n      email: \"\",\n      password: \"\",\n      submitted: false,\n      err: null,\n      isLoading: false \n    };\n  },\n  methods: {\n    async handleLogin() {\n      this.submitted = true;\n      this.err = null; \n\n      if (!this.email || !this.password) {\n        return; \n      }\n\n      this.isLoading = true;\n      let response;\n\n      try {\n        const { data } = await axios.post('http://localhost:8080/api/login', {\n          mail: this.email,\n          password: this.password\n        }, { withCredentials: true });\n        response = data;\n      } catch (error) {\n        response = { 'status': 'error', 'message': 'Çok Fazla İstek Atıldı.' };\n        console.error(error);\n      } finally {\n        this.isLoading = false;\n      }\n      if (response?.status == \"success\") {\n        this.$router.push('/');\n        const store = await import('@/store/UserStore');\n        const UserStore = store.useUserStore();\n        UserStore.authVerify();\n        window.dispatchEvent(new CustomEvent('session-created'));\n      } else {\n        this.err = true;\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.form-floating > .form-control:focus ~ label,\n.form-floating > .form-control:not(:placeholder-shown) ~ label {\n  color: #000;\n  opacity: 0.65;\n}\n.form-control:focus {\n  border-color: #000;\n  box-shadow: 0 0 0 0.25rem rgba(0, 0, 0, 0.1);\n}\n\n.login-btn {\n  transition: transform 0.2s;\n}\n.login-btn:hover:not(:disabled) {\n  transform: translateY(-2px);\n  background-color: #000;\n}\n</style>"],"mappings":";AA6EA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE,CAAC,eAAe,CAAC;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,KAAK;MAChBC,GAAG,EAAE,IAAI;MACTC,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI,CAACJ,SAAQ,GAAI,IAAI;MACrB,IAAI,CAACC,GAAE,GAAI,IAAI;MAEf,IAAI,CAAC,IAAI,CAACH,KAAI,IAAK,CAAC,IAAI,CAACC,QAAQ,EAAE;QACjC;MACF;MAEA,IAAI,CAACG,SAAQ,GAAI,IAAI;MACrB,IAAIG,QAAQ;MAEZ,IAAI;QACF,MAAM;UAAER;QAAK,IAAI,MAAMH,KAAK,CAACY,IAAI,CAAC,iCAAiC,EAAE;UACnEC,IAAI,EAAE,IAAI,CAACT,KAAK;UAChBC,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,EAAE;UAAES,eAAe,EAAE;QAAK,CAAC,CAAC;QAC7BH,QAAO,GAAIR,IAAI;MACjB,EAAE,OAAOY,KAAK,EAAE;QACdJ,QAAO,GAAI;UAAE,QAAQ,EAAE,OAAO;UAAE,SAAS,EAAE;QAA0B,CAAC;QACtEK,OAAO,CAACD,KAAK,CAACA,KAAK,CAAC;MACtB,UAAU;QACR,IAAI,CAACP,SAAQ,GAAI,KAAK;MACxB;MACA,IAAIG,QAAQ,EAAEM,MAAK,IAAK,SAAS,EAAE;QACjC,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,GAAG,CAAC;QACtB,MAAMC,KAAI,GAAI,MAAM,MAAM,CAAC,mBAAmB,CAAC;QAC/C,MAAMC,SAAQ,GAAID,KAAK,CAACE,YAAY,CAAC,CAAC;QACtCD,SAAS,CAACE,UAAU,CAAC,CAAC;QACtBC,MAAM,CAACC,aAAa,CAAC,IAAIC,WAAW,CAAC,iBAAiB,CAAC,CAAC;MAC1D,OAAO;QACL,IAAI,CAACnB,GAAE,GAAI,IAAI;MACjB;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}