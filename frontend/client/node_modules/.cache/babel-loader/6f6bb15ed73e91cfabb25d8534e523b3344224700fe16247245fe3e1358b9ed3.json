{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport { reactive, ref, computed, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport { useProductStore } from '../store/ProductsStore';\nexport default {\n  __name: 'DashboardProductEditView',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const route = useRoute();\n    const store = useProductStore();\n    const form = reactive({\n      product_id: '',\n      title: '',\n      price: 0,\n      stock: 0,\n      description: '',\n      thumbnail: '',\n      category: '',\n      category_fk: 1,\n      active: 1,\n      images: {},\n      newImage: {\n        image_url: undefined,\n        alt_text: undefined\n      }\n    });\n    const message = ref('');\n    const messageType = ref('alert-success');\n    const loading = ref(false);\n    const loaded = ref(false);\n    const categories = computed(() => store.categories);\n    function loadProductFromStore() {\n      const id = route.params.slug;\n      const p = store.products.find(p => String(p.product_id) == id);\n      form.active = p.active ?? 1;\n      if (p && categories) {\n        form.product_id = p.product_id;\n        form.title = p.title ?? '';\n        form.price = p.price ?? 0;\n        form.category = p.category ?? '';\n        form.category_fk = 0;\n        form.stock = p.stock ?? 0;\n        form.description = p.description ?? '';\n        form.thumbnail = p.thumbnail ?? '';\n        loaded.value = true;\n        form.images = p.images ?? '';\n      } else {\n        message.value = 'Ürün bulunamadı.';\n        messageType.value = 'alert-danger';\n      }\n    }\n    async function updateProduct() {\n      loading.value = true;\n      try {\n        const clonedData = JSON.parse(JSON.stringify(form));\n        await store.updateProduct(clonedData);\n        messageType.value = 'alert-success';\n        message.value = 'Ürün başarıyla güncellendi.';\n      } catch (err) {\n        console.error(err);\n        messageType.value = 'alert-danger';\n        message.value = 'Güncelleme hatası.';\n      } finally {\n        loading.value = false;\n      }\n    }\n    async function deleteImage(image_id) {\n      store.deleteProductImage(this.route.params.slug, image_id);\n    }\n    onMounted(loadProductFromStore);\n    const __returned__ = {\n      route,\n      store,\n      form,\n      message,\n      messageType,\n      loading,\n      loaded,\n      categories,\n      loadProductFromStore,\n      updateProduct,\n      deleteImage,\n      reactive,\n      ref,\n      computed,\n      onMounted,\n      get useRoute() {\n        return useRoute;\n      },\n      get useProductStore() {\n        return useProductStore;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["reactive","ref","computed","onMounted","useRoute","useProductStore","route","store","form","product_id","title","price","stock","description","thumbnail","category","category_fk","active","images","newImage","image_url","undefined","alt_text","message","messageType","loading","loaded","categories","loadProductFromStore","id","params","slug","p","products","find","String","value","updateProduct","clonedData","JSON","parse","stringify","err","console","error","deleteImage","image_id","deleteProductImage"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardProductEditView.vue"],"sourcesContent":["<template>\n  <section class=\"container mt-4\" style=\"max-width: 900px;\">\n    <div class=\"card shadow-sm border-0\">\n      <div class=\"card-body p-4\">\n\n        <h3 class=\"mb-4 fw-semibold\">Ürün Düzenle</h3>\n\n        <div v-if=\"message\" :class=\"`alert ${messageType} mb-4`\">{{ message }}</div>\n\n        <form v-if=\"loaded\" @submit.prevent=\"updateProduct\" class=\"row g-4\">\n\n          <div class=\"col-12\">\n            <label class=\"form-label fw-medium\">Başlık</label>\n            <input v-model=\"form.title\" type=\"text\" class=\"form-control form-control-lg\" required />\n          </div>\n\n          <div class=\"col-md-4\">\n            <label class=\"form-label fw-medium\">Fiyat (₺)</label>\n            <input v-model.number=\"form.price\" type=\"number\" step=\"0.01\" class=\"form-control\" required />\n          </div>\n\n          <div class=\"col-md-4\">\n            <label class=\"form-label fw-medium\">Kategori</label>\n            <select v-model=\"form.category\" class=\"form-select\" required>\n              <option value=\"\">Seçin</option>\n              <option v-for=\"c in categories\" :key=\"c.category_id\" :value=\"c.category_name\">\n                {{ c.category_name }}\n              </option>\n            </select>\n          </div>\n\n          <div class=\"col-md-4\">\n            <label class=\"form-label fw-medium\">Stok Adedi</label>\n            <input v-model.number=\"form.stock\" type=\"number\" min=\"0\" class=\"form-control\" />\n          </div>\n\n          <div class=\"col-12\">\n            <label class=\"form-label fw-medium\">Açıklama</label>\n            <textarea v-model=\"form.description\" class=\"form-control\" rows=\"3\"></textarea>\n          </div>\n\n          <div class=\"col-12\">\n            <label class=\"form-label fw-medium\">Thumbnail (URL)</label>\n            <input\n              v-model=\"form.thumbnail\"\n              type=\"url\"\n              class=\"form-control\"\n              placeholder=\"https://...\"\n            />\n            <img\n              v-if=\"form.thumbnail\"\n              :src=\"form.thumbnail\"\n              class=\"mt-3 rounded border\"\n              style=\"width: 160px; height: 110px; object-fit: cover;\"\n            />\n          </div>\n\n          <div class=\"col-12\">\n            <label class=\"form-label fw-medium\">Ürün Resimleri</label>\n\n            <div\n              v-for=\"image in form.images\"\n              :key=\"image.image_id\"\n              class=\"image-box p-3 border rounded mb-3 bg-light\"\n            >\n              <div class=\"row g-3\">\n                <div class=\"col-md-3 d-flex align-items-center justify-content-center\">\n                  <img\n                    :src=\"image.image_url\"\n                    :alt=\"image.alt_text\"\n                    class=\"rounded border\"\n                    style=\"width: 100%; object-fit: cover; max-height: 140px;\"\n                  />\n                </div>\n\n                <div class=\"col-md-9\">\n                  <label class=\"form-label\">Resim URL</label>\n                  <input type=\"text\" v-model=\"image.image_url\" class=\"form-control mb-3\" />\n\n                  <label class=\"form-label\">Alt Yazı</label>\n                  <input type=\"text\" v-model=\"image.alt_text\" class=\"form-control\" />\n                </div>\n                <button @click=\"deleteImage(image.image_id)\" type=\"button\" class=\"image-box-item btn btn-danger\">Resmi Sil</button>\n              </div>\n            </div>\n\n            <div class=\"p-3 border rounded bg-white\">\n              <label class=\"form-label fw-medium\">Yeni Resim Ekle</label>\n              <input type=\"text\" placeholder=\"Resim URL\" class=\"form-control mb-2\" v-model=\"form.newImage.image_url\"/>\n              <input type=\"text\" placeholder=\"Alt Yazı\" class=\"form-control\" v-model=\"form.newImage.alt_text\"/>\n            </div>\n          </div>\n\n          <div class=\"col-12\">\n            <label class=\"form-label fw-medium\">Aktiflik Durumu</label>\n            <select v-model=\"form.active\" class=\"form-select\">\n              <option :value=\"1\">Aktif</option>\n              <option :value=\"0\">Pasif</option>\n            </select>\n          </div>\n\n          <div class=\"col-12 d-flex justify-content-end gap-2 mt-3\">\n            <button class=\"btn btn-primary px-4\" type=\"submit\" :disabled=\"loading\">\n              {{ loading ? 'Güncelleniyor...' : 'Kaydet' }}\n            </button>\n\n            <router-link class=\"btn btn-outline-secondary px-4\" to=\"/dashboard/products\">\n              Geri\n            </router-link>\n          </div>\n        </form>\n\n        <p v-else class=\"text-muted\">Yükleniyor...</p>\n      </div>\n    </div>\n  </section>\n</template>\n\n\n<script setup>\nimport { reactive, ref, computed, onMounted } from 'vue'\nimport { useRoute } from 'vue-router'\nimport { useProductStore } from '../store/ProductsStore'\n\nconst route = useRoute()\nconst store = useProductStore()\n\nconst form = reactive({\n  product_id: '',\n  title: '',\n  price: 0,\n  stock: 0,\n  description: '',\n  thumbnail: '',\n  category:'',\n  category_fk:1,\n  active: 1,\n  images:{},\n  newImage:{image_url:undefined,alt_text:undefined}\n})\n\nconst message = ref('')\nconst messageType = ref('alert-success')\nconst loading = ref(false)\nconst loaded = ref(false)\n\nconst categories = computed(() => store.categories)\n\nfunction loadProductFromStore() {\n  const id = route.params.slug;\n  const p = (store.products).find(p => String(p.product_id) == id)\n  form.active = p.active ?? 1\n  if (p && categories) {\n    form.product_id = p.product_id\n    form.title = p.title ?? ''\n    form.price = p.price ?? 0\n    form.category = p.category ?? ''\n    form.category_fk = 0\n    form.stock = p.stock ?? 0\n    form.description = p.description ?? ''\n    form.thumbnail = p.thumbnail ?? ''\n    loaded.value = true\n    form.images = p.images ?? ''\n  } else {\n    message.value = 'Ürün bulunamadı.'\n    messageType.value = 'alert-danger'\n  }\n}\n\nasync function updateProduct() {\n  loading.value = true\n  try {\n    const clonedData = JSON.parse(JSON.stringify(form));\n    await store.updateProduct(clonedData);\n    messageType.value = 'alert-success'\n    message.value = 'Ürün başarıyla güncellendi.'\n  } catch (err) {\n    console.error(err)\n    messageType.value = 'alert-danger'\n    message.value = 'Güncelleme hatası.'\n  } finally {\n    loading.value = false\n  }\n\n}\n\nasync function deleteImage(image_id) {\n  store.deleteProductImage(this.route.params.slug ,image_id);\n}\n\nonMounted(loadProductFromStore)\n</script>\n\n\n<style scoped>\n  .image-box{\n    position:relative;\n  }\n\n  .image-box-item{\n    position: absolute;\n    top: -10px;\n    right: 20px;\n    width: 20%;\n    padding: 6px;\n  }\n</style>\n"],"mappings":";;AAwHA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAI;AACvD,SAASC,QAAQ,QAAQ,YAAW;AACpC,SAASC,eAAe,QAAQ,wBAAuB;;;;;;;IAEvD,MAAMC,KAAK,GAAGF,QAAQ,CAAC;IACvB,MAAMG,KAAK,GAAGF,eAAe,CAAC;IAE9B,MAAMG,IAAI,GAAGR,QAAQ,CAAC;MACpBS,UAAU,EAAE,EAAE;MACdC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,CAAC;MACRC,KAAK,EAAE,CAAC;MACRC,WAAW,EAAE,EAAE;MACfC,SAAS,EAAE,EAAE;MACbC,QAAQ,EAAC,EAAE;MACXC,WAAW,EAAC,CAAC;MACbC,MAAM,EAAE,CAAC;MACTC,MAAM,EAAC,CAAC,CAAC;MACTC,QAAQ,EAAC;QAACC,SAAS,EAACC,SAAS;QAACC,QAAQ,EAACD;MAAS;IAClD,CAAC;IAED,MAAME,OAAO,GAAGtB,GAAG,CAAC,EAAE;IACtB,MAAMuB,WAAW,GAAGvB,GAAG,CAAC,eAAe;IACvC,MAAMwB,OAAO,GAAGxB,GAAG,CAAC,KAAK;IACzB,MAAMyB,MAAM,GAAGzB,GAAG,CAAC,KAAK;IAExB,MAAM0B,UAAU,GAAGzB,QAAQ,CAAC,MAAMK,KAAK,CAACoB,UAAU;IAElD,SAASC,oBAAoBA,CAAA,EAAG;MAC9B,MAAMC,EAAE,GAAGvB,KAAK,CAACwB,MAAM,CAACC,IAAI;MAC5B,MAAMC,CAAC,GAAIzB,KAAK,CAAC0B,QAAQ,CAAEC,IAAI,CAACF,CAAC,IAAIG,MAAM,CAACH,CAAC,CAACvB,UAAU,CAAC,IAAIoB,EAAE;MAC/DrB,IAAI,CAACS,MAAM,GAAGe,CAAC,CAACf,MAAM,IAAI;MAC1B,IAAIe,CAAC,IAAIL,UAAU,EAAE;QACnBnB,IAAI,CAACC,UAAU,GAAGuB,CAAC,CAACvB,UAAS;QAC7BD,IAAI,CAACE,KAAK,GAAGsB,CAAC,CAACtB,KAAK,IAAI,EAAC;QACzBF,IAAI,CAACG,KAAK,GAAGqB,CAAC,CAACrB,KAAK,IAAI;QACxBH,IAAI,CAACO,QAAQ,GAAGiB,CAAC,CAACjB,QAAQ,IAAI,EAAC;QAC/BP,IAAI,CAACQ,WAAW,GAAG;QACnBR,IAAI,CAACI,KAAK,GAAGoB,CAAC,CAACpB,KAAK,IAAI;QACxBJ,IAAI,CAACK,WAAW,GAAGmB,CAAC,CAACnB,WAAW,IAAI,EAAC;QACrCL,IAAI,CAACM,SAAS,GAAGkB,CAAC,CAAClB,SAAS