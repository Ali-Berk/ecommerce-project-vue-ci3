{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport axios from 'axios';\nexport default {\n  name: \"DashboardOrderEdit\",\n  setup() {\n    const route = useRoute();\n    const order = ref({\n      items: [],\n      status: 0,\n      total_price: 0\n    });\n    const loading = ref(true);\n    const saving = ref(false);\n\n    // Toast Bildirim State'i\n    const toast = ref({\n      show: false,\n      message: '',\n      bg: '',\n      icon: ''\n    });\n    const showToast = (msg, type = 'success') => {\n      toast.value = {\n        show: true,\n        message: msg,\n        bg: type === 'success' ? 'bg-success' : 'bg-danger',\n        icon: type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle'\n      };\n      setTimeout(() => toast.value.show = false, 3000);\n    };\n\n    // Sipariş Verisini Çek\n    const fetchOrder = async () => {\n      try {\n        // Backend'de admin endpoint'i olmalı: /api/admin/order/{id}\n        const {\n          data\n        } = await axios.get(`http://localhost:8080/api/admin/order/${route.params.order_id}`, {\n          withCredentials: true\n        });\n        order.value = data;\n      } catch (error) {\n        showToast('Sipariş verisi yüklenemedi.', 'error');\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // Değişiklikleri Kaydet (Durum, Adres, İsim Düzeltmeleri)\n    const saveChanges = async () => {\n      saving.value = true;\n      try {\n        await axios.post('http://localhost:8080/api/admin/order_update', {\n          order_id: order.value.order_id,\n          status: order.value.status,\n          name: order.value.name,\n          address: order.value.address,\n          tel: order.value.tel,\n          mail: order.value.mail,\n          admin_note: order.value.admin_note\n        }, {\n          withCredentials: true\n        });\n        showToast('Sipariş başarıyla güncellendi.');\n      } catch (error) {\n        showToast('Güncelleme sırasında hata oluştu.', 'error');\n      } finally {\n        saving.value = false;\n      }\n    };\n\n    // Hızlı Durum Değiştirme (Örn: İptal Butonu)\n    const updateStatus = newStatus => {\n      if (confirm('Sipariş durumunu değiştirmek istediğinize emin misiniz?')) {\n        order.value.status = newStatus;\n        saveChanges();\n      }\n    };\n\n    // Duruma göre Selectbox rengi\n    const getStatusColor = status => {\n      if (status == 0) return 'text-warning border-warning';\n      if (status == 1) return 'text-primary border-primary';\n      if (status == 2) return 'text-info border-info';\n      if (status == 3) return 'text-success border-success';\n      if (status == -1) return 'text-danger border-danger';\n      return '';\n    };\n    onMounted(() => {\n      fetchOrder();\n    });\n    return {\n      order,\n      loading,\n      saving,\n      saveChanges,\n      updateStatus,\n      getStatusColor,\n      toast\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","axios","name","setup","route","order","items","status","total_price","loading","saving","toast","show","message","bg","icon","showToast","msg","type","value","setTimeout","fetchOrder","data","get","params","order_id","withCredentials","error","saveChanges","post","address","tel","mail","admin_note","updateStatus","newStatus","confirm","getStatusColor"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/DashboardOrderDetailView.vue"],"sourcesContent":["<template>\n  <div class=\"page-wrapper p-4 bg-light min-vh-100\">\n    \n    <div class=\"toast-container position-fixed bottom-0 end-0 p-3\" style=\"z-index: 1055\">\n      <div v-if=\"toast.show\" class=\"toast show align-items-center text-white border-0\" :class=\"toast.bg\">\n        <div class=\"d-flex\">\n          <div class=\"toast-body\">\n            <i class=\"bi me-2\" :class=\"toast.icon\"></i> {{ toast.message }}\n          </div>\n          <button type=\"button\" class=\"btn-close btn-close-white me-2 m-auto\" @click=\"toast.show = false\"></button>\n        </div>\n      </div>\n    </div>\n\n    <div v-if=\"loading\" class=\"text-center py-5\">\n      <div class=\"spinner-border text-primary\" role=\"status\"></div>\n      <p class=\"mt-2 text-muted\">Sipariş verileri çekiliyor...</p>\n    </div>\n\n    <div v-else class=\"container-fluid\">\n      \n      <div class=\"d-flex justify-content-between align-items-center mb-4\">\n        <div class=\"d-flex align-items-center gap-3\">\n          <button @click=\"$router.go(-1)\" class=\"btn btn-white border shadow-sm rounded-circle\">\n            <i class=\"bi bi-arrow-left\"></i>\n          </button>\n          <div>\n            <h4 class=\"fw-bold mb-0\">Sipariş Yönetimi</h4>\n            <small class=\"text-muted\">Sipariş Kodu: #{{ order.order_code }}</small>\n          </div>\n        </div>\n        \n        <div class=\"d-flex gap-2\">\n          <button \n            v-if=\"order.status != -1\" \n            @click=\"updateStatus(-1)\" \n            class=\"btn btn-outline-danger fw-bold\"\n            :disabled=\"saving\"\n          >\n            <i class=\"bi bi-x-circle me-1\"></i> Siparişi İptal Et\n          </button>\n          \n          <button \n            @click=\"saveChanges\" \n            class=\"btn btn-dark fw-bold px-4\"\n            :disabled=\"saving\"\n          >\n            <span v-if=\"saving\" class=\"spinner-border spinner-border-sm me-2\"></span>\n            {{ saving ? 'Kaydediliyor...' : 'Değişiklikleri Kaydet' }}\n          </button>\n        </div>\n      </div>\n\n      <div class=\"row g-4\">\n        \n        <div class=\"col-lg-4\">\n          <div class=\"card border-0 shadow-sm rounded-4 h-100\">\n            <div class=\"card-header bg-white border-bottom p-3\">\n              <h6 class=\"fw-bold mb-0 text-primary\"><i class=\"bi bi-person-gear me-2\"></i>Müşteri & Teslimat Bilgileri</h6>\n            </div>\n            <div class=\"card-body p-4\">\n              \n              <div class=\"mb-4\">\n                <label class=\"form-label fw-bold small text-muted\">Sipariş Durumu</label>\n                <select class=\"form-select form-select-lg fw-bold\" v-model=\"order.status\" :class=\"getStatusColor(order.status)\">\n                  <option :value=\"0\">Bekliyor (Onaylanmadı)</option>\n                  <option :value=\"1\">Hazırlanıyor</option>\n                  <option :value=\"2\">Kargoya Verildi</option>\n                  <option :value=\"3\">Teslim Edildi</option>\n                  <option :value=\"-1\">İptal Edildi</option>\n                </select>\n              </div>\n\n              <div class=\"mb-3\">\n                <label class=\"form-label small text-muted\">Müşteri Adı</label>\n                <input type=\"text\" class=\"form-control\" v-model=\"order.name\">\n              </div>\n\n              <div class=\"mb-3\">\n                <label class=\"form-label small text-muted\">Telefon</label>\n                <input type=\"text\" class=\"form-control\" v-model=\"order.tel\">\n              </div>\n\n              <div class=\"mb-3\">\n                <label class=\"form-label small text-muted\">E-Posta</label>\n                <input type=\"email\" class=\"form-control\" v-model=\"order.mail\">\n              </div>\n\n              <div class=\"mb-3\">\n                <label class=\"form-label small text-muted\">Teslimat Adresi</label>\n                <textarea class=\"form-control\" rows=\"4\" v-model=\"order.address\"></textarea>\n              </div>\n\n            </div>\n          </div>\n        </div>\n\n        <div class=\"col-lg-8\">\n          <div class=\"card border-0 shadow-sm rounded-4 mb-4\">\n            <div class=\"card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center\">\n              <h6 class=\"fw-bold mb-0\"><i class=\"bi bi-box-seam me-2\"></i>Sipariş İçeriği</h6>\n              <span class=\"badge bg-light text-dark border\">{{ order.items.length }} Ürün</span>\n            </div>\n            <div class=\"table-responsive\">\n              <table class=\"table align-middle mb-0\">\n                <thead class=\"bg-light\">\n                  <tr>\n                    <th class=\"ps-4\">Ürün</th>\n                    <th class=\"text-center\">Adet</th>\n                    <th class=\"text-end pe-4\">Fiyat</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr v-for=\"item in order.items\" :key=\"item.id\">\n                    <td class=\"ps-4\">\n                      <div class=\"d-flex align-items-center\">\n                        <img :src=\"item.thumbnail\" class=\"rounded border\" style=\"width: 40px; height: 40px; object-fit: cover;\">\n                        <div class=\"ms-3\">\n                          <div class=\"fw-bold\">{{ item.title }}</div>\n                          <small class=\"text-muted\">Kod: #{{ item.product_id }}</small>\n                        </div>\n                      </div>\n                    </td>\n                    <td class=\"text-center\">\n                      <span class=\"fw-bold\">{{ item.qty }}</span>\n                    </td>\n                    <td class=\"text-end pe-4\">\n                      {{ item.price * item.qty }} ₺\n                    </td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n            \n            <div class=\"card-footer bg-light p-4 text-end\">\n              <div class=\"d-inline-block text-start\" style=\"min-width: 200px;\">\n                <div class=\"d-flex justify-content-between mb-1\">\n                  <span class=\"text-muted\">Ara Toplam:</span>\n                  <span>{{ order.total_price }} ₺</span>\n                </div>\n                <div class=\"d-flex justify-content-between mb-1\">\n                  <span class=\"text-muted\">Kargo:</span>\n                  <span class=\"text-success fw-bold\">0 ₺</span>\n                </div>\n                <hr class=\"my-2\">\n                <div class=\"d-flex justify-content-between\">\n                  <span class=\"fw-bold fs-5\">Genel Toplam:</span>\n                  <span class=\"fw-bold fs-5 text-primary\">{{ order.total_price }} ₺</span>\n                </div>\n              </div>\n            </div>\n\n          </div>\n          \n          <div class=\"card border-0 shadow-sm rounded-4\">\n            <div class=\"card-body p-4\">\n              <label class=\"form-label fw-bold small text-muted\"><i class=\"bi bi-sticky me-2\"></i>Yönetici/Kargo Notu</label>\n              <textarea \n                class=\"form-control bg-light\" \n                rows=\"2\" \n                v-model=\"order.admin_note\" \n                placeholder=\"Örn: Müşteri arandı, kargo takip no girildi...\"\n              ></textarea>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport axios from 'axios';\n\nexport default {\n  name: \"DashboardOrderEdit\",\n  setup() {\n    const route = useRoute();\n    const order = ref({\n      items: [],\n      status: 0,\n      total_price: 0\n    });\n    const loading = ref(true);\n    const saving = ref(false);\n    \n    // Toast Bildirim State'i\n    const toast = ref({ show: false, message: '', bg: '', icon: '' });\n\n    const showToast = (msg, type = 'success') => {\n      toast.value = {\n        show: true,\n        message: msg,\n        bg: type === 'success' ? 'bg-success' : 'bg-danger',\n        icon: type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle'\n      };\n      setTimeout(() => toast.value.show = false, 3000);\n    };\n\n    // Sipariş Verisini Çek\n    const fetchOrder = async () => {\n      try {\n        // Backend'de admin endpoint'i olmalı: /api/admin/order/{id}\n        const { data } = await axios.get(`http://localhost:8080/api/admin/order/${route.params.order_id}`, { withCredentials: true });\n        order.value = data;\n      } catch (error) {\n        showToast('Sipariş verisi yüklenemedi.', 'error');\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // Değişiklikleri Kaydet (Durum, Adres, İsim Düzeltmeleri)\n    const saveChanges = async () => {\n      saving.value = true;\n      try {\n        await axios.post('http://localhost:8080/api/admin/order_update', {\n          order_id: order.value.order_id,\n          status: order.value.status,\n          name: order.value.name,\n          address: order.value.address,\n          tel: order.value.tel,\n          mail: order.value.mail,\n          admin_note: order.value.admin_note\n        }, { withCredentials: true });\n\n        showToast('Sipariş başarıyla güncellendi.');\n      } catch (error) {\n        showToast('Güncelleme sırasında hata oluştu.', 'error');\n      } finally {\n        saving.value = false;\n      }\n    };\n\n    // Hızlı Durum Değiştirme (Örn: İptal Butonu)\n    const updateStatus = (newStatus) => {\n      if(confirm('Sipariş durumunu değiştirmek istediğinize emin misiniz?')) {\n        order.value.status = newStatus;\n        saveChanges();\n      }\n    };\n\n    // Duruma göre Selectbox rengi\n    const getStatusColor = (status) => {\n      if(status == 0) return 'text-warning border-warning';\n      if(status == 1) return 'text-primary border-primary';\n      if(status == 2) return 'text-info border-info';\n      if(status == 3) return 'text-success border-success';\n      if(status == -1) return 'text-danger border-danger';\n      return '';\n    };\n\n    onMounted(() => {\n      fetchOrder();\n    });\n\n    return { order, loading, saving, saveChanges, updateStatus, getStatusColor, toast };\n  }\n};\n</script>\n\n<style scoped>\n.form-control:focus, .form-select:focus {\n  border-color: #000;\n  box-shadow: none;\n}\n/* Inputlar dashboard havasında, biraz daha kompakt */\n.form-label {\n  text-transform: uppercase;\n  font-size: 0.75rem;\n  letter-spacing: 0.5px;\n}\n</style>"],"mappings":"AA8KA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC,CAAC;IACxB,MAAMK,KAAI,GAAIP,GAAG,CAAC;MAChBQ,KAAK,EAAE,EAAE;MACTC,MAAM,EAAE,CAAC;MACTC,WAAW,EAAE;IACf,CAAC,CAAC;IACF,MAAMC,OAAM,GAAIX,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMY,MAAK,GAAIZ,GAAG,CAAC,KAAK,CAAC;;IAEzB;IACA,MAAMa,KAAI,GAAIb,GAAG,CAAC;MAAEc,IAAI,EAAE,KAAK;MAAEC,OAAO,EAAE,EAAE;MAAEC,EAAE,EAAE,EAAE;MAAEC,IAAI,EAAE;IAAG,CAAC,CAAC;IAEjE,MAAMC,SAAQ,GAAIA,CAACC,GAAG,EAAEC,IAAG,GAAI,SAAS,KAAK;MAC3CP,KAAK,CAACQ,KAAI,GAAI;QACZP,IAAI,EAAE,IAAI;QACVC,OAAO,EAAEI,GAAG;QACZH,EAAE,EAAEI,IAAG,KAAM,SAAQ,GAAI,YAAW,GAAI,WAAW;QACnDH,IAAI,EAAEG,IAAG,KAAM,SAAQ,GAAI,iBAAgB,GAAI;MACjD,CAAC;MACDE,UAAU,CAAC,MAAMT,KAAK,CAACQ,KAAK,CAACP,IAAG,GAAI,KAAK,EAAE,IAAI,CAAC;IAClD,CAAC;;IAED;IACA,MAAMS,UAAS,GAAI,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF;QACA,MAAM;UAAEC;QAAK,IAAI,MAAMrB,KAAK,CAACsB,GAAG,CAAC,yCAAyCnB,KAAK,CAACoB,MAAM,CAACC,QAAQ,EAAE,EAAE;UAAEC,eAAe,EAAE;QAAK,CAAC,CAAC;QAC7HrB,KAAK,CAACc,KAAI,GAAIG,IAAI;MACpB,EAAE,OAAOK,KAAK,EAAE;QACdX,SAAS,CAAC,6BAA6B,EAAE,OAAO,CAAC;MACnD,UAAU;QACRP,OAAO,CAACU,KAAI,GAAI,KAAK;MACvB;IACF,CAAC;;IAED;IACA,MAAMS,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9BlB,MAAM,CAACS,KAAI,GAAI,IAAI;MACnB,IAAI;QACF,MAAMlB,KAAK,CAAC4B,IAAI,CAAC,8CAA8C,EAAE;UAC/DJ,QAAQ,EAAEpB,KAAK,CAACc,KAAK,CAACM,QAAQ;UAC9BlB,MAAM,EAAEF,KAAK,CAACc,KAAK,CAACZ,MAAM;UAC1BL,IAAI,EAAEG,KAAK,CAACc,KAAK,CAACjB,IAAI;UACtB4B,OAAO,EAAEzB,KAAK,CAACc,KAAK,CAACW,OAAO;UAC5BC,GAAG,EAAE1B,KAAK,CAACc,KAAK,CAACY,GAAG;UACpBC,IAAI,EAAE3B,KAAK,CAACc,KAAK,CAACa,IAAI;UACtBC,UAAU,EAAE5B,KAAK,CAACc,KAAK,CAACc;QAC1B,CAAC,EAAE;UAAEP,eAAe,EAAE;QAAK,CAAC,CAAC;QAE7BV,SAAS,CAAC,gCAAgC,CAAC;MAC7C,EAAE,OAAOW,KAAK,EAAE;QACdX,SAAS,CAAC,mCAAmC,EAAE,OAAO,CAAC;MACzD,UAAU;QACRN,MAAM,CAACS,KAAI,GAAI,KAAK;MACtB;IACF,CAAC;;IAED;IACA,MAAMe,YAAW,GAAKC,SAAS,IAAK;MAClC,IAAGC,OAAO,CAAC,yDAAyD,CAAC,EAAE;QACrE/B,KAAK,CAACc,KAAK,CAACZ,MAAK,GAAI4B,SAAS;QAC9BP,WAAW,CAAC,CAAC;MACf;IACF,CAAC;;IAED;IACA,MAAMS,cAAa,GAAK9B,MAAM,IAAK;MACjC,IAAGA,MAAK,IAAK,CAAC,EAAE,OAAO,6BAA6B;MACpD,IAAGA,MAAK,IAAK,CAAC,EAAE,OAAO,6BAA6B;MACpD,IAAGA,MAAK,IAAK,CAAC,EAAE,OAAO,uBAAuB;MAC9C,IAAGA,MAAK,IAAK,CAAC,EAAE,OAAO,6BAA6B;MACpD,IAAGA,MAAK,IAAK,CAAC,CAAC,EAAE,OAAO,2BAA2B;MACnD,OAAO,EAAE;IACX,CAAC;IAEDR,SAAS,CAAC,MAAM;MACdsB,UAAU,CAAC,CAAC;IACd,CAAC,CAAC;IAEF,OAAO;MAAEhB,KAAK;MAAEI,OAAO;MAAEC,MAAM;MAAEkB,WAAW;MAAEM,YAAY;MAAEG,cAAc;MAAE1B;IAAM,CAAC;EACrF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}