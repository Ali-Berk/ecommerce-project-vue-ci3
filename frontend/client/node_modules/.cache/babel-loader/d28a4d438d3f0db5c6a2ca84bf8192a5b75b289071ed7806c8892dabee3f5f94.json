{"ast":null,"code":"export default {\n  name: \"ProfileView\",\n  props: ['user']\n};","map":{"version":3,"names":["name","props"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/ProfileView.vue"],"sourcesContent":["<template>\n  <div class=\"page-bg\">\n    <div class=\"container py-5\">\n      <div class=\"row g-4\">\n        \n        <div class=\"col-lg-3\">\n          <aside class=\"bg-white rounded-4 shadow-sm p-4 h-100 position-sticky top-0\" style=\"z-index: 1;\">\n            \n            <div class=\"d-flex align-items-center gap-3 mb-4 pb-4 border-bottom d-lg-none\">\n               <img src=\"https://wallpapers.com/images/featured/cool-profile-picture-87h46gcobjl5e4xu.jpg\" class=\"rounded-circle\" width=\"50\" height=\"50\">\n               <div>\n                  <h6 class=\"mb-0 fw-bold\">{{ user.name }}</h6>\n                  <small class=\"text-muted\">{{ user.role || 'Kullanıcı' }}</small>\n               </div>\n            </div>\n\n            <nav class=\"nav flex-column gap-2\">\n              <span class=\"text-uppercase text-muted small fw-bold mb-2 ps-3\">Hesap</span>\n              \n              <router-link to=\"/profile\" class=\"nav-link custom-link active-link\">\n                <i class=\"bi bi-person me-2\"></i> Profil Bilgileri\n              </router-link>\n              <router-link to=\"/orders\" class=\"nav-link custom-link\">\n                <i class=\"bi bi-box-seam me-2\"></i> Siparişlerim\n              </router-link>\n              <router-link to=\"/settings\" class=\"nav-link custom-link\">\n                <i class=\"bi bi-sliders me-2\"></i> Ayarlar\n              </router-link>\n\n              <span class=\"text-uppercase text-muted small fw-bold mt-4 mb-2 ps-3\">Diğer</span>\n              <a href=\"#\" class=\"nav-link custom-link text-danger\">\n                <i class=\"bi bi-box-arrow-left me-2\"></i> Çıkış Yap\n              </a>\n            </nav>\n          </aside>\n        </div>\n\n        <div class=\"col-lg-9\">\n          \n          <div class=\"d-flex justify-content-between align-items-center mb-4\">\n             <h4 class=\"fw-bold mb-0 text-dark\">Profilim</h4>\n             <div class=\"search-wrapper d-none d-md-block\">\n                <i class=\"bi bi-search text-muted position-absolute ms-3 mt-2 pt-1\"></i>\n                <input type=\"text\" class=\"form-control rounded-pill ps-5 border-0 shadow-sm\" placeholder=\"Hesabımda ara...\">\n             </div>\n          </div>\n\n          <div class=\"card border-0 shadow-sm rounded-4 overflow-hidden mb-4\">\n            <div class=\"profile-cover bg-primary\"></div> <div class=\"card-body p-0 position-relative\">\n              <div class=\"d-flex flex-column flex-md-row align-items-center align-items-md-end px-4 pb-4 pt-0 gap-4 mt-n5\">\n                <div class=\"avatar-wrapper\">\n                  <img src=\"https://wallpapers.com/images/featured/cool-profile-picture-87h46gcobjl5e4xu.jpg\"\n                  class=\"profile-img shadow-lg bg-white\">\n                  <span class=\"status-indicator bg-success border border-white\"></span>\n                </div>\n                \n                <div class=\"text-center text-md-start mb-2 flex-grow-1 mt-3 mt-md-0\">\n                  <h3 class=\"fw-bold mb-1\">{{ user.name || 'İsimsiz Kullanıcı' }}</h3>\n                  <p class=\"text-muted mb-0\">\n                    <i class=\"bi bi-envelope me-1\"></i> {{ user.mail || 'mail@adres.com' }}\n                  </p>\n                </div>\n\n                <router-link to=\"/settings\" class=\"btn btn-outline-primary rounded-pill px-4 mb-2\">\n                  <i class=\"bi bi-pencil-square me-2\"></i>Düzenle\n                </router-link>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"card border-0 shadow-sm rounded-4 p-4\">\n            <div class=\"d-flex align-items-center mb-4\">\n              <div class=\"icon-box bg-light text-primary rounded-circle me-3\">\n                <i class=\"bi bi-card-text fs-5\"></i>\n              </div>\n              <h5 class=\"fw-bold mb-0\">Detaylı Bilgiler</h5>\n            </div>\n\n            <div class=\"row g-4\">\n              <div class=\"col-md-6\">\n                <div class=\"p-3 border rounded-3 bg-light-subtle h-100\">\n                  <small class=\"text-uppercase text-muted fw-bold d-block mb-1\" style=\"font-size: 0.75rem;\">Ad Soyad</small>\n                  <span class=\"fw-medium text-dark fs-5\">{{ user.name || '-' }}</span>\n                </div>\n              </div>\n              \n              <div class=\"col-md-6\">\n                 <div class=\"p-3 border rounded-3 bg-light-subtle h-100\">\n                  <small class=\"text-uppercase text-muted fw-bold d-block mb-1\" style=\"font-size: 0.75rem;\">E-Posta Adresi</small>\n                  <span class=\"fw-medium text-dark fs-5\">{{ user.mail || '-' }}</span>\n                </div>\n              </div>\n\n              <div class=\"col-md-6\">\n                 <div class=\"p-3 border rounded-3 bg-light-subtle h-100\">\n                  <small class=\"text-uppercase text-muted fw-bold d-block mb-1\" style=\"font-size: 0.75rem;\">Kullanıcı Rolü</small>\n                  <span class=\"badge bg-dark rounded-pill px-3 py-2 mt-1\">{{ user.role || 'Kullanıcı' }}</span>\n                </div>\n              </div>\n\n              <div class=\"col-md-6\">\n                 <div class=\"p-3 border rounded-3 bg-light-subtle h-100\">\n                  <small class=\"text-uppercase text-muted fw-bold d-block mb-1\" style=\"font-size: 0.75rem;\">Teslimat Adresi</small>\n                  <span class=\"fw-medium text-dark\">{{ user.address || 'Henüz adres girilmemiş.' }}</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"ProfileView\",\n  props: ['user']\n}\n</script>\n\n<style scoped>\n/* Sayfa Genel */\n.page-bg {\n  background-color: #f8f9fa; /* Hafif gri arka plan */\n  min-height: 100vh;\n}\n\n/* Sidebar Linkleri */\n.custom-link {\n  color: #64748b;\n  font-weight: 500;\n  padding: 12px 20px;\n  border-radius: 12px;\n  transition: all 0.2s ease;\n  display: flex;\n  align-items: center;\n}\n\n.custom-link:hover {\n  background-color: #f1f5f9;\n  color: #0f172a;\n}\n\n/* Aktif Link (Router Link Active Class) */\n.router-link-exact-active {\n  background-color: #e0f2fe; /* Açık mavi */\n  color: #0284c7 !important; /* Koyu mavi */\n  font-weight: 600;\n}\n\n.router-link-exact-active i {\n  color: #0284c7;\n}\n\n/* Profil Cover & Avatar */\n.profile-cover {\n  height: 150px;\n  background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);\n  width: 100%;\n}\n\n.avatar-wrapper {\n  position: relative;\n}\n\n.profile-img {\n  width: 120px;\n  height: 120px;\n  border-radius: 50%;\n  border: 4px solid #fff;\n  object-fit: cover;\n}\n\n.status-indicator {\n  position: absolute;\n  bottom: 10px;\n  right: 10px;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n}\n\n/* .mt-n5 class'ı bootstrap'te yoksa diye manuel ekleme: margin-top: -3rem */\n.mt-n5 {\n  margin-top: -3.5rem !important;\n}\n\n/* İkon Kutusu */\n.icon-box {\n  width: 45px;\n  height: 45px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Arama Çubuğu */\n.search-wrapper {\n  position: relative;\n  width: 300px;\n}\n</style>"],"mappings":"AAoHA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE,CAAC,MAAM;AAChB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}