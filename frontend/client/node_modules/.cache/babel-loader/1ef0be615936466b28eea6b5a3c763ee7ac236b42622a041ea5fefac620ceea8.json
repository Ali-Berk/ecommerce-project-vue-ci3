{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { useOrdersStore } from '@/store/OrdersStore';\nexport default {\n  data() {\n    return {\n      isLoading: true,\n      activeFilter: 'all' // Varsayılan filtre: Tümü\n    };\n  },\n  computed: {\n    OrdersStore() {\n      return useOrdersStore();\n    },\n    // FİLTRELEME MANTIĞI BURADA\n    filteredOrders() {\n      const orders = this.OrdersStore.order_data || [];\n      if (this.activeFilter === 'all') {\n        return orders;\n      }\n      if (this.activeFilter === 'completed') {\n        // Durumu 'tamam' veya 'teslim' içerenleri getir\n        return orders.filter(order => order.status.toLowerCase().includes('tamam') || order.status.toLowerCase().includes('teslim'));\n      }\n      if (this.activeFilter === 'ongoing') {\n        // Tamamlanmamış VE İptal edilmemiş olanlar devam ediyordur\n        return orders.filter(order => !order.status.toLowerCase().includes('tamam') && !order.status.toLowerCase().includes('teslim') && !order.status.toLowerCase().includes('iptal'));\n      }\n      return orders;\n    }\n  },\n  methods: {\n    getStatusClass(status) {\n      const s = status ? status.toLowerCase() : '';\n      if (s.includes('tamam') || s.includes('teslim')) return 'bg-success-subtle text-success';\n      if (s.includes('kargo') || s.includes('yol')) return 'bg-info-subtle text-info';\n      if (s.includes('iptal')) return 'bg-danger-subtle text-danger';\n      return 'bg-warning-subtle text-warning';\n    }\n  },\n  async mounted() {\n    await this.OrdersStore.get_orders();\n    this.isLoading = false;\n  }\n};","map":{"version":3,"names":["useOrdersStore","data","isLoading","activeFilter","computed","OrdersStore","filteredOrders","orders","order_data","filter","order","status","toLowerCase","includes","methods","getStatusClass","s","mounted","get_orders"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/OrdersView.vue"],"sourcesContent":["<template>\n  <div class=\"profile-page-wrapper\">\n    <div class=\"container pb-5\">\n      <div class=\"row justify-content-center\">\n        \n        <div class=\"col-lg-10\">\n          \n          <div class=\"d-flex flex-column flex-md-row justify-content-between align-items-center mb-4\">\n            <h3 class=\"fw-bold mb-3 mb-md-0\">Siparişlerim</h3>\n            \n            <div class=\"d-flex gap-2\">\n              <button \n                class=\"btn rounded-pill px-4 btn-sm fw-medium transition-all\"\n                :class=\"activeFilter === 'all' ? 'btn-dark' : 'btn-white border text-muted'\"\n                @click=\"activeFilter = 'all'\"\n              >\n                Tümü\n              </button>\n              \n              <button \n                class=\"btn rounded-pill px-4 btn-sm fw-medium transition-all\"\n                :class=\"activeFilter === 'ongoing' ? 'btn-dark' : 'btn-white border text-muted'\"\n                @click=\"activeFilter = 'ongoing'\"\n              >\n                Devam Eden\n              </button>\n              \n              <button \n                class=\"btn rounded-pill px-4 btn-sm fw-medium transition-all\"\n                :class=\"activeFilter === 'completed' ? 'btn-dark' : 'btn-white border text-muted'\"\n                @click=\"activeFilter = 'completed'\"\n              >\n                Tamamlanan\n              </button>\n            </div>\n          </div>\n\n          <div v-if=\"isLoading\" class=\"text-center py-5\">\n            <div class=\"spinner-border text-primary\" role=\"status\"></div>\n            <p class=\"text-muted mt-2\">Siparişleriniz getiriliyor...</p>\n          </div>\n\n          <div v-else-if=\"OrdersStore.status_data === 'error'\" class=\"alert alert-danger rounded-4 shadow-sm border-0 d-flex align-items-center gap-3\">\n            <i class=\"bi bi-exclamation-triangle-fill fs-4\"></i>\n            <div><strong>Bir hata oluştu.</strong> Sipariş verileri yüklenemedi.</div>\n          </div>\n\n          <div v-else-if=\"filteredOrders.length === 0\" class=\"text-center py-5 bg-white rounded-4 shadow-sm border\">\n             <div class=\"bg-light rounded-circle d-inline-flex p-4 mb-3\">\n                <i class=\"bi bi-filter-circle fs-1 text-muted\"></i>\n             </div>\n             <h4 class=\"fw-bold\">Bu kategoride sipariş bulunamadı.</h4>\n             <p class=\"text-muted mb-4\" v-if=\"activeFilter !== 'all'\">Diğer filtreleri deneyebilir veya tüm siparişlerinize göz atabilirsiniz.</p>\n             <p class=\"text-muted mb-4\" v-else>Henüz hiç sipariş vermediniz.</p>\n             \n             <button v-if=\"activeFilter !== 'all'\" @click=\"activeFilter = 'all'\" class=\"btn btn-outline-dark rounded-pill px-4\">\n                Tümünü Göster\n             </button>\n             <router-link v-else to=\"/\" class=\"btn btn-primary rounded-pill px-5 py-2 fw-bold\">Alışverişe Başla</router-link>\n          </div>\n\n          <div v-else class=\"d-flex flex-column gap-4\">\n            \n            <div \n              v-for=\"order in filteredOrders\" \n              :key=\"order.order_id\" \n              class=\"order-card bg-white rounded-4 shadow-sm overflow-hidden border\"\n            >\n              <div class=\"card-header-custom p-4 border-bottom bg-light-subtle d-flex flex-wrap gap-3 justify-content-between align-items-center\">\n                <div class=\"d-flex gap-4 align-items-center\">\n                  <div class=\"d-flex align-items-center gap-2\">\n                    <div class=\"icon-box bg-white border rounded-circle text-primary\">\n                      <i class=\"bi bi-calendar3\"></i>\n                    </div>\n                    <div>\n                      <small class=\"text-muted d-block fw-bold\" style=\"font-size: 0.7rem;\">SİPARİŞ TARİHİ</small>\n                      <span class=\"fw-medium text-dark\">order.order_date</span>\n                    </div>\n                  </div>\n                  <div class=\"d-none d-sm-block border-start ps-4\">\n                    <small class=\"text-muted d-block fw-bold\" style=\"font-size: 0.7rem;\">SİPARİŞ NO</small>\n                    <span class=\"fw-medium text-dark font-monospace\">#{{ order.order_id }}</span>\n                  </div>\n                </div>\n                <div>\n                   <span class=\"badge rounded-pill py-2 px-3 fw-bold status-badge\" :class=\"getStatusClass(order.status)\">\n                      {{ order.status }}\n                   </span>\n                </div>\n              </div>\n\n              <div class=\"p-4\">\n                <div class=\"row align-items-center g-4\">\n                  <div class=\"col-md-8\">\n                    <div class=\"d-flex gap-3 align-items-start\">\n                      <div class=\"product-icon-placeholder bg-light rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 text-muted\">\n                        <i class=\"bi bi-box-seam fs-3\"></i>\n                      </div>\n                      <div>\n                        <h6 class=\"fw-bold text-dark mb-1\">Teslimat Adresi: <span class=\"fw-normal text-muted\">{{ order.order_address }}</span></h6>\n                        <p class=\"text-muted mb-0 small\"><i class=\"bi bi-basket me-1\"></i> İçerik: {{ order.product_titles }}</p>\n                      </div>\n                    </div>\n                  </div>\n                  <div class=\"col-md-4 text-md-end\">\n                    <small class=\"text-muted fw-bold\">TOPLAM TUTAR</small>\n                    <h4 class=\"fw-bold text-primary mb-3\">{{ order.total_price }} ₺</h4>\n                    <router-link :to=\"'orders/'+order.order_id\" class=\"btn btn-outline-dark rounded-pill w-100 stretched-link-custom\">\n                      Sipariş Detayı <i class=\"bi bi-arrow-right ms-2\"></i>\n                    </router-link>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { useOrdersStore } from '@/store/OrdersStore';\n\nexport default {\n  data() {\n    return {\n      isLoading: true,\n      activeFilter: 'all' // Varsayılan filtre: Tümü\n    };\n  },\n  computed: {\n    OrdersStore() {\n      return useOrdersStore();\n    },\n    // FİLTRELEME MANTIĞI BURADA\n    filteredOrders() {\n      const orders = this.OrdersStore.order_data || [];\n\n      if (this.activeFilter === 'all') {\n        return orders;\n      }\n      \n      if (this.activeFilter === 'completed') {\n        // Durumu 'tamam' veya 'teslim' içerenleri getir\n        return orders.filter(order => \n          order.status.toLowerCase().includes('tamam') || \n          order.status.toLowerCase().includes('teslim')\n        );\n      }\n      \n      if (this.activeFilter === 'ongoing') {\n        // Tamamlanmamış VE İptal edilmemiş olanlar devam ediyordur\n        return orders.filter(order => \n          !order.status.toLowerCase().includes('tamam') && \n          !order.status.toLowerCase().includes('teslim') &&\n          !order.status.toLowerCase().includes('iptal')\n        );\n      }\n\n      return orders;\n    }\n  },\n  methods: {\n    getStatusClass(status) {\n      const s = status ? status.toLowerCase() : '';\n      if (s.includes('tamam') || s.includes('teslim')) return 'bg-success-subtle text-success';\n      if (s.includes('kargo') || s.includes('yol')) return 'bg-info-subtle text-info';\n      if (s.includes('iptal')) return 'bg-danger-subtle text-danger';\n      return 'bg-warning-subtle text-warning';\n    }\n  },\n  async mounted() {\n    await this.OrdersStore.get_orders();\n    this.isLoading = false;\n  },\n};\n</script>\n\n<style scoped>\n/* Sayfa Yapısı */\n.profile-page-wrapper {\n  background-color: #f8f9fa;\n  min-height: 100vh;\n  padding-top: 120px;\n}\n\n/* Buton Geçiş Efekti */\n.transition-all {\n  transition: all 0.3s ease;\n}\n\n/* Sipariş Kartı */\n.order-card {\n  transition: transform 0.2s, box-shadow 0.2s;\n  border-color: #eef1f6 !important;\n}\n\n.order-card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08) !important;\n}\n\n.icon-box {\n  width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;\n}\n\n.product-icon-placeholder {\n  width: 60px; height: 60px;\n}\n\n.status-badge {\n  font-size: 0.8rem; letter-spacing: 0.5px;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .order-card .card-header-custom {\n    flex-direction: column; align-items: flex-start;\n  }\n  .order-card .col-md-4 {\n    text-align: left !important; border-top: 1px dashed #dee2e6; padding-top: 1rem; margin-top: 0.5rem;\n  }\n}\n</style>"],"mappings":";;AA4HA,SAASA,cAAa,QAAS,qBAAqB;AAEpD,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,IAAI;MACfC,YAAY,EAAE,KAAI,CAAE;IACtB,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,OAAOL,cAAc,CAAC,CAAC;IACzB,CAAC;IACD;IACAM,cAAcA,CAAA,EAAG;MACf,MAAMC,MAAK,GAAI,IAAI,CAACF,WAAW,CAACG,UAAS,IAAK,EAAE;MAEhD,IAAI,IAAI,CAACL,YAAW,KAAM,KAAK,EAAE;QAC/B,OAAOI,MAAM;MACf;MAEA,IAAI,IAAI,CAACJ,YAAW,KAAM,WAAW,EAAE;QACrC;QACA,OAAOI,MAAM,CAACE,MAAM,CAACC,KAAI,IACvBA,KAAK,CAACC,MAAM,CAACC,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,OAAO,KAC3CH,KAAK,CAACC,MAAM,CAACC,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,QAAQ,CAC9C,CAAC;MACH;MAEA,IAAI,IAAI,CAACV,YAAW,KAAM,SAAS,EAAE;QACnC;QACA,OAAOI,MAAM,CAACE,MAAM,CAACC,KAAI,IACvB,CAACA,KAAK,CAACC,MAAM,CAACC,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,OAAO,KAC5C,CAACH,KAAK,CAACC,MAAM,CAACC,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,QAAQ,KAC7C,CAACH,KAAK,CAACC,MAAM,CAACC,WAAW,CAAC,CAAC,CAACC,QAAQ,CAAC,OAAO,CAC9C,CAAC;MACH;MAEA,OAAON,MAAM;IACf;EACF,CAAC;EACDO,OAAO,EAAE;IACPC,cAAcA,CAACJ,MAAM,EAAE;MACrB,MAAMK,CAAA,GAAIL,MAAK,GAAIA,MAAM,CAACC,WAAW,CAAC,IAAI,EAAE;MAC5C,IAAII,CAAC,CAACH,QAAQ,CAAC,OAAO,KAAKG,CAAC,CAACH,QAAQ,CAAC,QAAQ,CAAC,EAAE,OAAO,gCAAgC;MACxF,IAAIG,CAAC,CAACH,QAAQ,CAAC,OAAO,KAAKG,CAAC,CAACH,QAAQ,CAAC,KAAK,CAAC,EAAE,OAAO,0BAA0B;MAC/E,IAAIG,CAAC,CAACH,QAAQ,CAAC,OAAO,CAAC,EAAE,OAAO,8BAA8B;MAC9D,OAAO,gCAAgC;IACzC;EACF,CAAC;EACD,MAAMI,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACZ,WAAW,CAACa,UAAU,CAAC,CAAC;IACnC,IAAI,CAAChB,SAAQ,GAAI,KAAK;EACxB;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}