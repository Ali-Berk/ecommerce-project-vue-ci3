{"ast":null,"code":"import axios from 'axios';\nimport { useRoute } from 'vue-router';\nexport default {\n  name: 'ProductDetail',\n  data() {\n    return {\n      product: null,\n      selectedImage: null\n    };\n  },\n  mounted() {\n    const route = useRoute();\n    const slug = route.params.slug;\n    axios.get(`http://localhost:8080/api/detail/${slug}`).then(res => {\n      this.product = res.data.data;\n    }).catch(err => {\n      console.error('Ürün yüklenemedi:', err);\n    });\n  }\n};","map":{"version":3,"names":["axios","useRoute","name","data","product","selectedImage","mounted","route","slug","params","get","then","res","catch","err","console","error"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/ProductDetailsView.vue"],"sourcesContent":["<template>\n  <section class=\"container my-5\" v-if=\"product\">\n    \n    <nav aria-label=\"breadcrumb\" class=\"mb-4\">\n      <ol class=\"breadcrumb\">\n        <li class=\"breadcrumb-item\"><a href=\"#\" class=\"text-decoration-none text-muted\">Anasayfa</a></li>\n        <li class=\"breadcrumb-item\"><a href=\"#\" class=\"text-decoration-none text-muted\">Kategori</a></li>\n        <li class=\"breadcrumb-item active text-dark fw-bold\" aria-current=\"page\">{{ product.name }}</li>\n      </ol>\n    </nav>\n\n    <div class=\"row g-5\">\n      <div class=\"col-lg-7\">\n        <div class=\"gallery-container position-relative\">\n          \n          <div class=\"main-image-wrapper shadow-sm mb-4\">\n            <img\n              :src=\"selectedImage || product.thumbnail\"\n              alt=\"Ürün Görseli\"\n              class=\"main-image\"\n            />\n            <!-- <span class=\"badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill\">Yeni</span> -->\n          </div>\n          \n          <div class=\"position-relative px-4\">\n            <button v-if=\"product.images && product.images.length > 4\"\n                class=\"btn btn-white nav-btn start-0\"\n                type=\"button\"\n                @click=\"document.getElementById('thumb-inner').scrollBy({ left: -120, behavior: 'smooth' })\">\n                <i class=\"bi bi-chevron-left\"></i>\n            </button>\n            \n            <div class=\"thumb-scroller\" id=\"thumb-inner\">\n                <div class=\"d-flex gap-3\">\n                    <div\n                    v-for=\"(img, index) in product.images\"\n                    :key=\"index\"\n                    class=\"thumb-wrapper\"\n                    :class=\"{ 'active-thumb': (selectedImage === img.image_url) || (!selectedImage && index === 0) }\"\n                    @click=\"selectedImage = img.image_url\"\n                    >\n                    <img\n                    :src=\"img.image_url\"\n                    alt=\"Ürün küçük görseli\"\n                    class=\"thumb-image\"\n                    />\n                </div>\n              </div>\n            </div>\n          \n            <button v-if=\"product.images && product.images.length > 4\"\n              class=\"btn btn-white nav-btn end-0\"\n              type=\"button\"\n              @click=\"document.getElementById('thumb-inner').scrollBy({ left: 120, behavior: 'smooth' })\">\n              <i class=\"bi bi-chevron-right\"></i>\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      <div class=\"col-lg-5\">\n        <div class=\"product-info-sticky\">\n          \n          <h1 class=\"display-6 fw-bold mb-2 text-dark\">{{ product.name }}</h1>\n          \n          <div class=\"d-flex align-items-center gap-3 mb-4\">\n            <h2 class=\"price-tag mb-0\">₺{{ product.price }}</h2>\n            <span class=\"text-muted text-decoration-line-through fs-5\" v-if=\"false\">₺9999</span> </div>\n\n          <p class=\"text-muted description-text mb-5\">{{ product.description }}</p>\n          \n          <div class=\"mb-4 p-3 bg-light rounded-3 border border-light\">\n             <div class=\"d-flex align-items-center gap-2 text-muted\">\n                <i class=\"bi bi-info-circle\"></i>\n                <span>Standart Beden / Tek Ebat</span>\n             </div>\n          </div>\n          \n          <div class=\"d-flex gap-3 mb-4\">\n            <button class=\"btn btn-dark btn-lg flex-grow-1 rounded-pill py-3 shadow-lg btn-add-cart\">\n               Sepete Ekle\n            </button>\n            <button class=\"btn btn-outline-secondary btn-lg rounded-circle btn-fav\">\n               <i class=\"bi bi-heart\"></i>\n            </button>\n          </div>\n\n          <div class=\"features small text-muted\">\n            <div class=\"d-flex align-items-center gap-3 mb-2\">\n                <i class=\"bi bi-truck fs-5 text-dark\"></i>\n                <span>2-3 iş günü içinde kargoda</span>\n            </div>\n            <div class=\"d-flex align-items-center gap-3\">\n                <i class=\"bi bi-shield-check fs-5 text-dark\"></i>\n                <span>%100 Güvenli Ödeme ve İade Garantisi</span>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script>\nimport axios from 'axios'\nimport { useRoute } from 'vue-router'\n\nexport default {\n    name: 'ProductDetail',\n    data() {\n        return {\n            product: null,\n            selectedImage: null,\n        }\n    },\n    mounted() {\n        const route = useRoute()\n    const slug = route.params.slug\n\n    axios\n      .get(`http://localhost:8080/api/detail/${slug}`)\n      .then((res) => {\n        this.product = res.data.data\n      })\n      .catch((err) => {\n        console.error('Ürün yüklenemedi:', err)\n      })\n  },\n}\n</script>\n\n<style scoped>\n/* Genel Yapı */\n.main-image-wrapper {\n  height: 500px; /* Görsel alanını büyüttük */\n  background: #fff;\n  border-radius: 20px;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid #f0f0f0;\n}\n\n.main-image {\n  max-width: 100%;\n  max-height: 100%;\n  object-fit: contain;\n  transition: transform 0.3s ease;\n}\n\n.main-image-wrapper:hover .main-image {\n  transform: scale(1.02);\n}\n\n/* Thumbnail Slider */\n.thumb-scroller {\n  overflow-x: hidden; /* Scroll barı gizle */\n  white-space: nowrap;\n  padding: 5px 0;\n  scroll-behavior: smooth;\n}\n\n.thumb-wrapper {\n  width: 80px;\n  height: 80px;\n  border-radius: 12px;\n  overflow: hidden;\n  cursor: pointer;\n  border: 2px solid transparent;\n  opacity: 0.6;\n  transition: all 0.2s ease;\n  background: #fff;\n}\n\n.thumb-wrapper:hover {\n  opacity: 1;\n}\n\n.thumb-wrapper.active-thumb {\n  border-color: #000; /* Seçili görsel çerçevesi siyah */\n  opacity: 1;\n  transform: translateY(-2px);\n}\n\n.thumb-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* Navigasyon Okları */\n.nav-btn {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 35px;\n  height: 35px;\n  border-radius: 50%;\n  background: white;\n  box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid #eee;\n  z-index: 10;\n  transition: all 0.2s;\n}\n\n.nav-btn:hover {\n  background: #000;\n  color: #fff;\n}\n\n/* Sağ Taraf - Ürün Bilgisi */\n.product-info-sticky {\n  position: sticky;\n  top: 100px; /* Navbar yüksekliğine göre ayarlanabilir */\n}\n\n.price-tag {\n  font-size: 2rem;\n  font-weight: 800;\n  color: #000;\n  letter-spacing: -1px;\n}\n\n.description-text {\n  font-size: 1rem;\n  line-height: 1.7;\n}\n\n/* Butonlar */\n.btn-add-cart {\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  transition: transform 0.2s;\n}\n\n.btn-add-cart:hover {\n  transform: translateY(-2px);\n  background-color: #222;\n}\n\n.btn-fav {\n  width: 58px;\n  height: 58px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-color: #ddd;\n}\n\n.btn-fav:hover {\n  background-color: #ffe5e5;\n  border-color: #ffcccc;\n  color: #dc3545;\n}\n\n/* Mobil Uyumluluk */\n@media (max-width: 991px) {\n  .main-image-wrapper {\n    height: 350px;\n  }\n  .product-info-sticky {\n    position: static;\n  }\n}\n</style>"],"mappings":"AA0GA,OAAOA,KAAI,MAAO,OAAM;AACxB,SAASC,QAAO,QAAS,YAAW;AAEpC,eAAe;EACXC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,OAAO,EAAE,IAAI;MACbC,aAAa,EAAE;IACnB;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IAC3B,MAAMO,IAAG,GAAID,KAAK,CAACE,MAAM,CAACD,IAAG;IAE7BR,KAAI,CACDU,GAAG,CAAC,oCAAoCF,IAAI,EAAE,EAC9CG,IAAI,CAAEC,GAAG,IAAK;MACb,IAAI,CAACR,OAAM,GAAIQ,GAAG,CAACT,IAAI,CAACA,IAAG;IAC7B,CAAC,EACAU,KAAK,CAAEC,GAAG,IAAK;MACdC,OAAO,CAACC,KAAK,CAAC,mBAAmB,EAAEF,GAAG;IACxC,CAAC;EACL;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}