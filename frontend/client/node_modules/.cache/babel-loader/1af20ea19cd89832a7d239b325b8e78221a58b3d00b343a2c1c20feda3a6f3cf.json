{"ast":null,"code":"import axios from 'axios';\nimport { useUserStore } from '../store/UserStore'; // UserStore importu\n\nexport default {\n  name: 'NavbarComponent',\n  props: ['category', 'user'],\n  data() {\n    return {\n      searchActive: false,\n      searchQuery: ''\n    };\n  },\n  computed: {\n    UserStore() {\n      return useUserStore(); // store'a erişim\n    }\n  },\n  methods: {\n    toggleSearchBar() {\n      this.searchActive = !this.searchActive;\n    },\n    logout() {\n      axios.get('http://localhost:8080/api/logout', {\n        withCredentials: true\n      }).catch(err => console.log(err)).then(() => location.reload());\n    }\n  },\n  mounted() {\n    const offcanvasEl = document.getElementById('cartOffcanvas');\n    offcanvasEl.addEventListener('hidden.bs.offcanvas', () => {\n      const backdrop = document.querySelector('.offcanvas-backdrop');\n      if (backdrop) backdrop.remove();\n    });\n  }\n};","map":{"version":3,"names":["axios","useUserStore","name","props","data","searchActive","searchQuery","computed","UserStore","methods","toggleSearchBar","logout","get","withCredentials","catch","err","console","log","then","location","reload","mounted","offcanvasEl","document","getElementById","addEventListener","backdrop","querySelector","remove"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/components/Navbar.vue"],"sourcesContent":["<script>\nimport axios from 'axios';\nimport { useUserStore } from '../store/UserStore'; // UserStore importu\n\nexport default {\n  name: 'NavbarComponent',\n  props: ['category', 'user'],\n  data() {\n    return {\n      searchActive: false,\n      searchQuery: '',\n    };\n  },\n  computed: {\n    UserStore() {\n      return useUserStore(); // store'a erişim\n    }\n  },\n  methods: {\n    toggleSearchBar() {\n      this.searchActive = !this.searchActive;\n    },\n    logout() {\n      axios.get('http://localhost:8080/api/logout', { withCredentials: true })\n        .catch(err => console.log(err))\n        .then(() => location.reload());\n    }\n  },\n  mounted() {\n    const offcanvasEl = document.getElementById('cartOffcanvas');\n    offcanvasEl.addEventListener('hidden.bs.offcanvas', () => {\n      const backdrop = document.querySelector('.offcanvas-backdrop');\n      if (backdrop) backdrop.remove();\n    });\n  }\n};\n</script>\n\n<template>\n  <section class=\"container\">\n    <!-- ... navbar kodu ... -->\n\n    <div\n      class=\"offcanvas offcanvas-end\"\n      tabindex=\"-1\"\n      id=\"cartOffcanvas\"\n      aria-labelledby=\"cartOffcanvasLabel\"\n      data-bs-backdrop=\"true\"\n      data-bs-scroll=\"false\"\n    >\n      <div class=\"offcanvas-header\">\n        <h5 id=\"cartOffcanvasLabel\">Sepetim</h5>\n        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"offcanvas\" aria-label=\"Kapat\"></button>\n      </div>\n      <div class=\"offcanvas-body\">\n        <div v-if=\"UserStore.cart.length === 0\">\n          <p>Sepetiniz şu anda boş.</p>\n        </div>\n        <div v-else>\n          <div v-for=\"item in UserStore.cart\" :key=\"item.id\" class=\"d-flex justify-content-between align-items-center mb-3\">\n            <img :src=\"item.thumbnail\" alt=\"Ürün\" style=\"width:50px; height:50px; object-fit:cover;\">\n            <div class=\"flex-grow-1 ms-2\">\n              <p class=\"mb-0\">{{ item.name }}</p>\n              <small>{{ item.quantity }} x {{ item.price }} TL</small>\n            </div>\n            <div>\n              <strong>{{ item.quantity * item.price }} TL</strong>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n"],"mappings":"AACA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,YAAW,QAAS,oBAAoB,EAAE;;AAEnD,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,UAAU,EAAE,MAAM,CAAC;EAC3BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE,KAAK;MACnBC,WAAW,EAAE;IACf,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,SAASA,CAAA,EAAG;MACV,OAAOP,YAAY,CAAC,CAAC,EAAE;IACzB;EACF,CAAC;E