{"ast":null,"code":"import axios from 'axios';\nimport { useRoute } from 'vue-router';\nimport { useUserStore } from '@/store/UserStore'; // STORE IMPORT EDİLDİ\n\nexport default {\n  name: 'ProductDetail',\n  data() {\n    return {\n      product: null,\n      selectedImage: null,\n      loading: true,\n      isFavorite: false\n    };\n  },\n  computed: {\n    // Pinia Store Bağlantısı\n    UserStore() {\n      return useUserStore();\n    }\n  },\n  methods: {\n    scrollThumbs(amount) {\n      const container = document.getElementById('thumb-inner');\n      if (container) {\n        container.scrollBy({\n          left: amount,\n          behavior: 'smooth'\n        });\n      }\n    },\n    addToCart() {\n      if (this.product) {\n        // Store üzerindeki aksiyonu çağırıyoruz\n        this.UserStore.addToCart(this.product);\n        // İsteğe bağlı: Kullanıcıya bildirim verilebilir (Toast msg vb.)\n      }\n    },\n    toggleFavorite() {\n      this.isFavorite = !this.isFavorite;\n    }\n  },\n  mounted() {\n    const route = useRoute();\n    const slug = route.params.slug;\n    this.loading = true;\n    axios.get(`http://localhost:8080/api/detail/${slug}`).then(res => {\n      this.product = res.data.data;\n      // Ana görseli seçili hale getir\n      // this.selectedImage = this.product.thumbnail; \n    }).catch(err => {\n      console.error('Ürün yüklenemedi:', err);\n    }).finally(() => {\n      this.loading = false;\n    });\n  }\n};","map":{"version":3,"names":["axios","useRoute","useUserStore","name","data","product","selectedImage","loading","isFavorite","computed","UserStore","methods","scrollThumbs","amount","container","document","getElementById","scrollBy","left","behavior","addToCart","toggleFavorite","mounted","route","slug","params","get","then","res","catch","err","console","error","finally"],"sources":["/home/aliberk/Masaüstü/ecommerce/frontend/client/src/views/ProductDetailsView.vue"],"sourcesContent":["<template>\n  <div class=\"page-wrapper\">\n    \n    <div v-if=\"loading\" class=\"d-flex justify-content-center align-items-center min-vh-50 py-5\">\n      <div class=\"spinner-border text-dark\" role=\"status\">\n        <span class=\"visually-hidden\">Yükleniyor...</span>\n      </div>\n    </div>\n\n    <div v-else-if=\"!product && !loading\" class=\"text-center py-5\">\n      <h3>Ürün bulunamadı.</h3>\n      <router-link to=\"/\" class=\"btn btn-dark mt-3 rounded-pill px-4\">Anasayfaya Dön</router-link>\n    </div>\n\n    <section class=\"container my-5\" v-else>\n      \n      <nav aria-label=\"breadcrumb\" class=\"mb-4\">\n        <ol class=\"breadcrumb\">\n          <li class=\"breadcrumb-item\">\n            <router-link to=\"/\" class=\"text-decoration-none text-muted\">Anasayfa</router-link>\n          </li>\n          <li class=\"breadcrumb-item\">\n            <a href=\"#\" class=\"text-decoration-none text-muted\">Ürünler</a>\n          </li>\n          <li class=\"breadcrumb-item active text-dark fw-bold\" aria-current=\"page\">{{ product.name }}</li>\n        </ol>\n      </nav>\n\n      <div class=\"row g-5\">\n        <div class=\"col-lg-7\">\n          <div class=\"gallery-container position-relative\">\n            \n            <div class=\"main-image-wrapper shadow-sm mb-4\">\n              <img\n                :src=\"selectedImage || product.thumbnail\"\n                :alt=\"product.name\"\n                class=\"main-image\"\n              />\n              <span v-if=\"product.is_new\" class=\"badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill\">Yeni</span>\n            </div>\n            \n            <div class=\"position-relative px-4\" v-if=\"product.images && product.images.length > 0\">\n              <button v-if=\"product.images.length > 4\"\n                  class=\"btn btn-white nav-btn start-0\"\n                  type=\"button\"\n                  @click=\"scrollThumbs(-120)\">\n                  <i class=\"bi bi-chevron-left\"></i>\n              </button>\n              \n              <div class=\"thumb-scroller\" id=\"thumb-inner\">\n                  <div class=\"d-flex gap-3\">\n                      <div \n                        class=\"thumb-wrapper\"\n                        :class=\"{ 'active-thumb': (selectedImage === product.thumbnail) || (!selectedImage) }\"\n                        @click=\"selectedImage = product.thumbnail\"\n                      >\n                        <img :src=\"product.thumbnail\" class=\"thumb-image\" />\n                      </div>\n\n                      <div\n                        v-for=\"(img, index) in product.images\"\n                        :key=\"index\"\n                        class=\"thumb-wrapper\"\n                        :class=\"{ 'active-thumb': selectedImage === img.image_url }\"\n                        @click=\"selectedImage = img.image_url\"\n                      >\n                      <img :src=\"img.image_url\" class=\"thumb-image\" />\n                  </div>\n                </div>\n              </div>\n            \n              <button v-if=\"product.images.length > 4\"\n                class=\"btn btn-white nav-btn end-0\"\n                type=\"button\"\n                @click=\"scrollThumbs(120)\">\n                <i class=\"bi bi-chevron-right\"></i>\n              </button>\n            </div>\n\n          </div>\n        </div>\n\n        <div class=\"col-lg-5\">\n          <div class=\"product-info-sticky\">\n            \n            <h1 class=\"display-6 fw-bold mb-2 text-dark\">{{ product.name }}</h1>\n            \n            <div class=\"d-flex align-items-center gap-3 mb-4\">\n              <h2 class=\"price-tag mb-0\">₺{{ product.price }}</h2>\n            </div>\n\n            <p class=\"text-muted description-text mb-5\">{{ product.description }}</p>\n            \n            <div class=\"mb-4 p-3 bg-light rounded-3 border border-light\">\n               <div class=\"d-flex align-items-center gap-2 text-muted\">\n                  <i class=\"bi bi-info-circle\"></i>\n                  <span>Standart Boyut / Özel Tasarım</span>\n               </div>\n            </div>\n            \n            <div class=\"d-flex gap-3 mb-4\">\n              <button \n                class=\"btn btn-dark btn-lg flex-grow-1 rounded-pill py-3 shadow-lg btn-add-cart\"\n                @click=\"addToCart\"\n              >\n                 Sepete Ekle\n              </button>\n\n              <button \n                class=\"btn btn-lg rounded-circle btn-fav transition-all\"\n                :class=\"isFavorite ? 'btn-danger text-white border-danger' : 'btn-outline-secondary'\"\n                @click=\"toggleFavorite\"\n              >\n                 <i class=\"bi\" :class=\"isFavorite ? 'bi-heart-fill' : 'bi-heart'\"></i>\n              </button>\n            </div>\n\n            <div class=\"features small text-muted\">\n              <div class=\"d-flex align-items-center gap-3 mb-2\">\n                  <i class=\"bi bi-truck fs-5 text-dark\"></i>\n                  <span>2-3 iş günü içinde kargoda</span>\n              </div>\n              <div class=\"d-flex align-items-center gap-3\">\n                  <i class=\"bi bi-shield-check fs-5 text-dark\"></i>\n                  <span>%100 Güvenli Ödeme ve İade Garantisi</span>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport { useRoute } from 'vue-router'\nimport { useUserStore } from '@/store/UserStore' // STORE IMPORT EDİLDİ\n\nexport default {\n    name: 'ProductDetail',\n    data() {\n        return {\n            product: null,\n            selectedImage: null,\n            loading: true,\n            isFavorite: false\n        }\n    },\n    computed: {\n      // Pinia Store Bağlantısı\n      UserStore() {\n        return useUserStore();\n      }\n    },\n    methods: {\n      scrollThumbs(amount) {\n        const container = document.getElementById('thumb-inner');\n        if(container) {\n          container.scrollBy({ left: amount, behavior: 'smooth' });\n        }\n      },\n      addToCart() {\n        if(this.product) {\n          // Store üzerindeki aksiyonu çağırıyoruz\n          this.UserStore.addToCart(this.product);\n          // İsteğe bağlı: Kullanıcıya bildirim verilebilir (Toast msg vb.)\n        }\n      },\n      toggleFavorite() {\n        this.isFavorite = !this.isFavorite;\n      }\n    },\n    mounted() {\n      const route = useRoute()\n      const slug = route.params.slug\n      this.loading = true;\n\n      axios\n        .get(`http://localhost:8080/api/detail/${slug}`)\n        .then((res) => {\n          this.product = res.data.data;\n          // Ana görseli seçili hale getir\n          // this.selectedImage = this.product.thumbnail; \n        })\n        .catch((err) => {\n          console.error('Ürün yüklenemedi:', err)\n        })\n        .finally(() => {\n          this.loading = false;\n        })\n    },\n}\n</script>\n\n<style scoped>\n/* Navbar üstüne binmemesi için */\n.page-wrapper {\n  padding-top: 20px; \n}\n\n/* Genel Yapı */\n.main-image-wrapper {\n  height: 500px;\n  background: #fff;\n  border-radius: 20px;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid #f0f0f0;\n  position: relative;\n}\n\n.main-image {\n  max-width: 100%;\n  max-height: 100%;\n  object-fit: contain;\n  transition: transform 0.3s ease;\n}\n\n.main-image-wrapper:hover .main-image {\n  transform: scale(1.02);\n}\n\n/* Thumbnail Slider */\n.thumb-scroller {\n  overflow-x: hidden;\n  white-space: nowrap;\n  padding: 5px 0;\n  scroll-behavior: smooth;\n  /* Scrollbarı tamamen gizlemek için */\n  scrollbar-width: none; \n  -ms-overflow-style: none;\n}\n.thumb-scroller::-webkit-scrollbar { \n    display: none; \n}\n\n.thumb-wrapper {\n  width: 80px;\n  height: 80px;\n  border-radius: 12px;\n  overflow: hidden;\n  cursor: pointer;\n  border: 2px solid transparent;\n  opacity: 0.6;\n  transition: all 0.2s ease;\n  background: #fff;\n  flex-shrink: 0; /* Küçülmeyi engeller */\n}\n\n.thumb-wrapper:hover {\n  opacity: 1;\n}\n\n.thumb-wrapper.active-thumb {\n  border-color: #000;\n  opacity: 1;\n  transform: translateY(-2px);\n}\n\n.thumb-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* Navigasyon Okları */\n.nav-btn {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 35px;\n  height: 35px;\n  border-radius: 50%;\n  background: white;\n  box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid #eee;\n  z-index: 10;\n  transition: all 0.2s;\n}\n\n.nav-btn:hover {\n  background: #000;\n  color: #fff;\n}\n\n/* Sağ Taraf - Ürün Bilgisi */\n.product-info-sticky {\n  position: sticky;\n  top: 100px;\n}\n\n.price-tag {\n  font-size: 2rem;\n  font-weight: 800;\n  color: #000;\n  letter-spacing: -1px;\n}\n\n.description-text {\n  font-size: 1rem;\n  line-height: 1.7;\n}\n\n/* Butonlar */\n.btn-add-cart {\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  transition: transform 0.2s;\n}\n\n.btn-add-cart:hover {\n  transform: translateY(-2px);\n  background-color: #222;\n}\n\n.btn-fav {\n  width: 58px;\n  height: 58px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.3s ease;\n}\n\n.btn-fav:hover {\n  background-color: #ffe5e5;\n  border-color: #ffcccc;\n  color: #dc3545;\n}\n\n.min-vh-50 {\n  min-height: 50vh;\n}\n\n.transition-all {\n  transition: all 0.3s ease;\n}\n\n/* Mobil Uyumluluk */\n@media (max-width: 991px) {\n  .main-image-wrapper {\n    height: 350px;\n  }\n  .product-info-sticky {\n    position: static;\n  }\n}\n</style>"],"mappings":"AAwIA,OAAOA,KAAI,MAAO,OAAM;AACxB,SAASC,QAAO,QAAS,YAAW;AACpC,SAASC,YAAW,QAAS,mBAAkB,EAAE;;AAEjD,eAAe;EACXC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,OAAO,EAAE,IAAI;MACbC,aAAa,EAAE,IAAI;MACnBC,OAAO,EAAE,IAAI;MACbC,UAAU,EAAE;IAChB;EACJ,CAAC;EACDC,QAAQ,EAAE;IACR;IACAC,SAASA,CAAA,EAAG;MACV,OAAOR,YAAY,CAAC,CAAC;IACvB;EACF,CAAC;EACDS,OAAO,EAAE;IACPC,YAAYA,CAACC,MAAM,EAAE;MACnB,MAAMC,SAAQ,GAAIC,QAAQ,CAACC,cAAc,CAAC,aAAa,CAAC;MACxD,IAAGF,SAAS,EAAE;QACZA,SAAS,CAACG,QAAQ,CAAC;UAAEC,IAAI,EAAEL,MAAM;UAAEM,QAAQ,EAAE;QAAS,CAAC,CAAC;MAC1D;IACF,CAAC;IACDC,SAASA,CAAA,EAAG;MACV,IAAG,IAAI,CAACf,OAAO,EAAE;QACf;QACA,IAAI,CAACK,SAAS,CAACU,SAAS,CAAC,IAAI,CAACf,OAAO,CAAC;QACtC;MACF;IACF,CAAC;IACDgB,cAAcA,CAAA,EAAG;MACf,IAAI,CAACb,UAAS,GAAI,CAAC,IAAI,CAACA,UAAU;IACpC;EACF,CAAC;EACDc,OAAOA,CAAA,EAAG;IACR,MAAMC,KAAI,GAAItB,QAAQ,CAAC;IACvB,MAAMuB,IAAG,GAAID,KAAK,CAACE,MAAM,CAACD,IAAG;IAC7B,IAAI,CAACjB,OAAM,GAAI,IAAI;IAEnBP,KAAI,CACD0B,GAAG,CAAC,oCAAoCF,IAAI,EAAE,EAC9CG,IAAI,CAAEC,GAAG,IAAK;MACb,IAAI,CAACvB,OAAM,GAAIuB,GAAG,CAACxB,IAAI,CAACA,IAAI;MAC5B;MACA;IACF,CAAC,EACAyB,KAAK,CAAEC,GAAG,IAAK;MACdC,OAAO,CAACC,KAAK,CAAC,mBAAmB,EAAEF,GAAG;IACxC,CAAC,EACAG,OAAO,CAAC,MAAM;MACb,IAAI,CAAC1B,OAAM,GAAI,KAAK;IACtB,CAAC;EACL;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}